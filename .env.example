BOT_TOKEN=1234567890:replace_with_token_from_BotFather
DATABASE_PATH=data/gnida_bot.sqlite3
KARGASSIA_CHAT_ID=-1001234567890
YUKASSA_SHOP_ID=your_yookassa_shop_id
YUKASSA_SECRET_KEY=your_yookassa_secret_key
YUKASSA_RETURN_URL=https://t.me/your_bot_username
# Public HTTPS URL of THIS Python service; configure it as Main Mini App in BotFather.
WEBAPP_URL=https://your-bot-domain.bothost.tech
# BotHost PORT takes precedence. Do not run webapp/battle-client with Node.js.
WEBAPP_PORT=8080
# Maximum concurrent Telegram update handlers (1–64), defaults to 24.
TELEGRAM_UPDATES_LIMIT=24
# Read-only memory measurements in logs. 0 disables them; default is 60 seconds.
MEMORY_LOG_INTERVAL_SECONDS=60
# Send rate-limited private error reports to the bot's existing owner. 0 disables DMs.
ERROR_DM_ENABLED=1
# Live Stars sales are enabled. Set 0 to stop new invoices and pre-checkout.
PETS_PAYMENTS_ENABLED=1
