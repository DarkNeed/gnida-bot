  return '<div class="raid-dialogue" data-boss="'+esc(data.boss_id)+'" role="status" aria-live="polite"><div class="raid-dialogue-portrait"></div><div><b>'+esc(d.speaker||'ФУФЕЛШМЕРЦ')+'</b><p>'+esc(d.text)+'</p><small>'+esc(d.warning||'')+'</small></div></div>';
}
function raidSupport(data){
  if(data.boss_id!=='doofenshmirtz')return '';
