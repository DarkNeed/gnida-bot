/* Independent, authenticated RP constructor. No normal profile writes. */
(()=>{
  'use strict';
  let previous=null;
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const names={max_hp:'HP',resource_max:'Энергия',physical_attack:'Физ. атака',magic_attack:'Маг. атака',physical_defense:'Физ. защита',magic_defense:'Маг. защита',speed:'Скорость',evasion:'Уклонение'};
  const clone=v=>JSON.parse(JSON.stringify(v));
  const button=(label,action,cls='',disabled=false)=>'<button type="button" data-rp="'+esc(action)+'" class="'+cls+'"'+(disabled?' disabled':'')+'>'+label+'</button>';
  window.RPApp={open};

  async function open(context){
    previous?.abort();
    const abort=new AbortController();previous=abort;
    const {app,onRaid}=context;
    let catalog,templates=[],chats=[],chat=context.chat??null,section='character',editing=null,busy=false;
    let search='',filter='',picker='skills',onlySelected=false,roster=[],nonce=crypto.randomUUID(),previewRequest=0,previewTimer,previewSkills=new Map();
    const initData=context.initData??window.Telegram?.WebApp?.initData??'';
    const notice=message=>context.toast?.(message);
    async function request(path,body,method){
      const response=await fetch(path,{method:method||(body?'POST':'GET'),headers:{'X-Telegram-Init-Data':initData,...(body?{'Content-Type':'application/json'}:{})},body:body?JSON.stringify(body):undefined});
      const result=await response.json();if(!response.ok)throw Error(result.error||'Ошибка запроса');return result;
    }
    const cls=id=>catalog.classes.find(c=>c.id===id);
    const kindLabel=k=>k==='mob'?'Моб':'Персонаж';
    const image=v=>'/rp/images/'+v+'.png';
    function artwork(v,field='sprite_key'){
      const base=cls(v.class_id),branch=base?.branches.find(b=>b.id===v.archclass_id);
      return v[field]?image(v[field]):v.avatar_key?image(v.avatar_key):catalog.mobs.find(m=>m.id===v.preset_id)?.sprite||(branch?(v.level>=20&&v.archclass_stage===20?branch.final_avatar:branch.avatar):base?.avatar||'/static/assets/ragamuffin.png');
    }
    function defaultValue(){return {name:section==='mob'?'Новый противник':'Новый персонаж',description:'',class_id:'ragamuffin',archclass_id:'',archclass_stage:20,level:1,skills:['bum_punch'],passives:catalog.passives.filter(p=>p.class_id==='ragamuffin').map(p=>p.skill_id),stats:{},ai:'random',defense_mode:'dodge',avatar_key:'',sprite_key:'',flip:false,scale:1};}
    function shell(body){
      app.innerHTML='<section class="rp-screen"><header class="rp-header"><div><span class="eyebrow">ГНИДА · RP-ПЕСОЧНИЦА</span><h1>Своя история. Свои правила.</h1><p>Отдельные сборки, без наград и изменений основной прогрессии.</p></div><div class="rp-tools">'+button('↻','reload','small')+'<button type="button" class="audio-button settings-button" data-combat-open aria-label="Настройки боя">⚙</button><button type="button" class="audio-button" data-audio-open aria-label="Настройки звука">♫</button></div></header><div class="rp-chat"><label>Чат встречи<select id="rp-chat"><option value="">Выбери чат</option>'+chats.map(c=>'<option value="'+c.chat_id+'"'+(chat===c.chat_id?' selected':'')+'>'+esc(c.title)+'</option>').join('')+'</select></label><small>Шаблоны личные и общие для твоих чатов.</small></div><nav class="rp-tabs" aria-label="RP-разделы">'+[['character','Мои персонажи'],['mob','Мои мобы'],['encounters','Встречи']].map(([id,name])=>button(name,'section:'+id,section===id?'primary':'')).join('')+'</nav><main class="rp-content">'+body+'</main></section>';
      window.ArenaAudio?.refresh();
    }
    function renderList(){
      const list=templates.filter(t=>t.kind===section);
      shell('<div class="rp-section-title"><div><span class="eyebrow">'+(section==='mob'?'ЛИЧНЫЙ БЕСТИАРИЙ':'БЕЗ ДОНАТНЫХ СЛОТОВ')+'</span><h2>'+ (section==='mob'?'Твои противники':'Твои RP-персонажи')+'</h2></div>'+button('＋ Создать','new','primary')+'</div><div class="rp-template-grid">'+list.map(t=>{
        const v=t.definition;
        return '<article class="rp-template"><div class="rp-template-art"><img src="'+esc(artwork(v))+'" alt="'+esc(v.name)+'" style="transform:scaleX('+(v.flip?-1:1)+')"></div><div class="rp-template-body"><span class="eyebrow">'+esc(cls(v.class_id)?.name)+' · LV.'+v.level+'</span><h3>'+esc(v.name)+'</h3><p>'+esc(v.description||'История ещё не написана.')+'</p><small>'+v.skills.length+' активных · '+v.passives.length+' пассивных</small><div class="rp-row">'+button('Редактировать','edit:'+t.id,'primary')+button('Копия','copy:'+t.id,'small')+button('Удалить','delete:'+t.id,'small danger')+'</div></div></article>';
      }).join('')+(list.length?'':'<div class="rp-empty"><h3>Здесь начинается история</h3><p>Создай '+(section==='mob'?'противника для своей встречи':'персонажа с любыми доступными навыками')+'. Обычная арена останется нетронутой.</p></div>')+'</div>'+(section==='mob'?'<section class="rp-presets"><h3>Взять за основу</h3><div class="rp-row">'+catalog.mobs.map(m=>button(esc(m.name),'preset:'+m.id)).join('')+'</div><p class="muted">Копируется отдельный противник. Сценарные действия исходной встречи не копируются.</p></section>':''));
    }
    function editor(){
      const v=editing.definition,c=cls(v.class_id),branches=c?.branches||[];
      shell('<div class="rp-section-title"><div><span class="eyebrow">'+kindLabel(section)+' · РЕДАКТОР</span><h2>'+esc(v.name)+'</h2></div>'+button('← К списку','back')+'</div><div class="rp-editor"><section class="rp-card"><div class="rp-portrait"><img id="rp-art" src="'+esc(artwork(v))+'" alt="Предпросмотр спрайта" style="transform:scaleX('+(v.flip?-1:1)+') scale('+v.scale+')"></div><div class="rp-art-controls"><label>Изображение PNG<input type="file" id="rp-avatar" accept="image/png"></label><label>Боевой спрайт PNG<input type="file" id="rp-sprite" accept="image/png"></label><small>До 2 МБ, 16–1024 px. Для спрайта нужен прозрачный фон. Лучше, чтобы он смотрел вправо.</small><label class="rp-check"><input type="checkbox" data-field="flip"'+(v.flip?' checked':'')+'> Отразить по горизонтали</label>'+button('Стандартные изображения','reset-art','small')+'</div><label>Имя<input data-field="name" maxlength="80" value="'+esc(v.name)+'"></label><label>Описание<textarea data-field="description" maxlength="2000" rows="3">'+esc(v.description)+'</textarea></label><div class="rp-form-grid"><label>Класс<select data-field="class_id">'+catalog.classes.map(x=>'<option value="'+esc(x.id)+'"'+(v.class_id===x.id?' selected':'')+'>'+esc(x.name)+'</option>').join('')+'</select></label><label>Уровень<input data-field="level" type="number" min="1" max="20" value="'+v.level+'"></label><label>Архикласс<select data-field="archclass_id"'+(v.level<10?' disabled':'')+'><option value="">Остаться в классе · мастерство</option>'+branches.map(b=>'<option value="'+esc(b.id)+'"'+(v.archclass_id===b.id?' selected':'')+'>'+esc(b.name)+(v.level>=20?' → '+esc(b.final_name):'')+'</option>').join('')+'</select></label><label>Путь на 20 уровне<select data-field="archclass_stage"'+(v.level<20||!v.archclass_id?' disabled':'')+'><option value="20"'+(v.archclass_stage===20?' selected':'')+'>Финальный архикласс</option><option value="10"'+(v.archclass_stage===10?' selected':'')+'>Мастерство текущей ветки</option></select></label><label>Защита<select data-field="defense_mode"><option value="dodge"'+(v.defense_mode==='dodge'?' selected':'')+'>Уклонение</option><option value="block"'+(v.defense_mode==='block'?' selected':'')+'>Блокирование</option></select></label>'+(section==='mob'?'<label>Поведение<select data-field="ai">'+[['random','Случайный доступный навык'],['sequence','По порядку, пропуская недоступные'],['priority','Первый доступный по приоритету']].map(([id,n])=>'<option value="'+id+'"'+(v.ai===id?' selected':'')+'>'+n+'</option>').join('')+'</select></label><label>Размер спрайта<input data-field="scale" type="number" min="0.5" max="2" step="0.1" value="'+v.scale+'"></label>':'')+'</div></section><aside class="rp-card"><span class="eyebrow">СЕРВЕРНЫЙ РАСЧЁТ</span><h3>Характеристики</h3><div id="rp-stats">Вычисляем…</div><p class="muted">Энергия, перезарядки, условия накоплений и лимиты применений действуют. Свободная экипировка не выдаёт механику другого класса.</p><div id="rp-warnings" role="status"></div><div class="rp-save">'+button('Сохранить сборку','save','primary')+button('Отмена','back')+'</div></aside></div><section class="rp-card rp-library"><div class="rp-section-title"><div><span class="eyebrow">БЕЗ ЛИМИТА ЭКИПИРОВКИ</span><h3>Каталог навыков</h3></div><b id="rp-equipped">'+v.skills.length+' активных · '+v.passives.length+' пассивных</b></div><div class="rp-row">'+button('Активные','picker:skills',picker==='skills'?'primary':'')+button('Пассивные','picker:passives',picker==='passives'?'primary':'')+'</div><div class="rp-search"><input id="rp-search" type="search" value="'+esc(search)+'" placeholder="Найти навык, эффект или босса…" aria-label="Поиск навыков"><select id="rp-filter" aria-label="Фильтр навыков"><option value="">Все классы и боссы</option><option value="boss"'+(filter==='boss'?' selected':'')+'>Атаки боссов</option>'+catalog.classes.map(x=>'<option value="'+esc(x.id)+'"'+(filter===x.id?' selected':'')+'>'+esc(x.name)+'</option>').join('')+'</select><label class="rp-check"><input type="checkbox" id="rp-only"'+(onlySelected?' checked':'')+'> Только выбранные</label></div><p class="muted">Порядок выбранных активных навыков задаёт последовательность или приоритеты моба. Сценарии боссов помечены отдельно.</p><div id="rp-selected"></div><div id="rp-skills"></div></section>');
      renderSkills();schedulePreview();
    }
    function renderSkills(){
      if(!editing||!document.getElementById('rp-skills'))return;
      const selected=editing.definition[picker],list=catalog[picker].map(s=>picker==='skills'&&previewSkills.has(s.skill_id)?{...s,...previewSkills.get(s.skill_id)}:s);
      document.getElementById('rp-equipped').textContent=editing.definition.skills.length+' активных · '+editing.definition.passives.length+' пассивных';
      document.getElementById('rp-selected').innerHTML=picker==='skills'&&selected.length?'<details class="rp-selected"><summary>Порядок выбранных навыков · '+selected.length+'</summary>'+selected.map((id,i)=>'<div class="rp-order"><span>'+(i+1)+'. '+esc(list.find(s=>s.skill_id===id)?.name||id)+'</span>'+button('↑','move:'+id+':-1','small',!i)+button('↓','move:'+id+':1','small',i===selected.length-1)+'</div>').join('')+'</details>':'';
      const query=search.toLocaleLowerCase('ru');
      const shown=list.filter(s=>(!onlySelected||selected.includes(s.skill_id))&&(!query||(s.name+' '+s.description+' '+(s.warnings||[]).join(' ')).toLocaleLowerCase('ru').includes(query))&&(!filter||(filter==='boss'?s.skill_id.startsWith('kit_')||s.skill_id.startsWith('whaler_')||s.skill_id.startsWith('doof_')||s.skill_id.startsWith('chaplain_')||s.skill_id.startsWith('raid_')||s.skill_id.startsWith('lei_'):s.class_id===filter)));
      const groups=new Map();for(const s of shown){const group=cls(s.class_id)?.name||'Общие навыки';if(!groups.has(group))groups.set(group,[]);groups.get(group).push(s);}
      document.getElementById('rp-skills').innerHTML=[...groups].map(([group,items])=>'<details class="rp-skill-group" open><summary>'+esc(group)+' · '+items.length+'</summary><div class="rp-skill-list">'+items.map(s=>'<label class="rp-skill'+(selected.includes(s.skill_id)?' selected':'')+'"><input type="checkbox" data-rp-skill="'+esc(s.skill_id)+'"'+(selected.includes(s.skill_id)?' checked':'')+'><span><b>'+esc(s.name)+'</b><small>'+esc(s.description||'Эффекты: '+(s.effects||[]).map(e=>e.kind+' '+e.value).join(', '))+'</small>'+(picker==='skills'?'<small>Энергия '+s.cost+' · сила '+s.power+' · точность '+s.accuracy+'% · КД '+s.cooldown+'</small>':'')+(s.scripted?'<em>Сценарное действие: отдельно не применяется</em>':'')+'</span></label>').join('')+'</div></details>').join('')||'<p class="muted">Навыки не найдены.</p>';
    }
    function fieldValue(el){return el.type==='checkbox'?el.checked:el.type==='number'||el.dataset.field==='archclass_stage'?Number(el.value):el.value;}
    function schedulePreview(){previewRequest++;clearTimeout(previewTimer);previewTimer=setTimeout(preview,250);}
    async function preview(){
      if(!editing||abort.signal.aborted)return;
      const seq=++previewRequest;
      try{
        const result=await request('/api/rp/preview',{kind:section,definition:editing.definition});
        if(seq!==previewRequest||!editing||abort.signal.aborted)return;
        const target=document.getElementById('rp-stats');if(!target)return;
        previewSkills=new Map(result.skills.map(s=>[s.skill_id,s]));renderSkills();
        const focused=document.activeElement?.dataset?.stat;
        if(!focused)target.innerHTML='<div class="rp-stat-grid">'+Object.entries(result.stats).filter(([k])=>names[k]).map(([key,value])=>'<label>'+names[key]+(section==='mob'?'<input type="number" min="'+(['max_hp','resource_max'].includes(key)?1:0)+'" max="'+(key==='evasion'?100:key==='max_hp'?100000:10000)+'" data-stat="'+key+'" value="'+value+'">':'<b>'+value+'</b>')+'</label>').join('')+'</div>'+(section==='mob'?button('Пересчитать по классу','reset-stats','small'):'');
        const notes=[...new Set(result.skills.flatMap(s=>[...(s.warnings||[]),...(s.unavailable_reason?[s.name+': '+s.unavailable_reason]:[])]))];
        document.getElementById('rp-warnings').innerHTML=notes.length?'<details class="rp-warning"><summary>Условия и совместимость · '+notes.length+'</summary>'+notes.map(n=>'<p>'+esc(n)+'</p>').join('')+'</details>':'<p class="rp-valid">✓ Сборка проверена</p>';
      }catch(error){
        if(seq!==previewRequest||!editing||abort.signal.aborted)return;
        const target=document.getElementById('rp-stats');
        if(target)target.innerHTML='<p>Не удалось рассчитать характеристики.</p>'+button('Повторить расчёт','retry-preview','small');
        const warnings=document.getElementById('rp-warnings');if(warnings)warnings.textContent=error.message;
      }
    }
    async function renderEncounters(){
      if(!chat){shell('<div class="rp-empty"><h2>Выбери чат для встречи</h2><p>Создателем может стать любой участник. Он станет мастером и сможет остаться наблюдателем или вступить в отряд.</p></div>');return;}
      const result=await request('/api/rp/encounters?chat='+chat);if(abort.signal.aborted||section!=='encounters')return;
      const mobs=templates.filter(t=>t.kind==='mob');
      shell('<div class="rp-section-title"><div><span class="eyebrow">УЧАСТИЕ МАСТЕРА — ПО ЖЕЛАНИЮ</span><h2>Собрать встречу</h2></div></div><section class="rp-card"><p>До трёх игроков против трёх противников. Игроки выбирают обычных персонажей или свои RP-сборки. Наград и реальных расходников нет.</p><div class="rp-row"><select id="rp-enemy" aria-label="Противник для встречи">'+catalog.mobs.map(m=>'<option value="builtin:'+m.id+'">'+esc(m.name)+' · готовый моб</option>').join('')+mobs.map(m=>'<option value="mob:'+m.id+'">'+esc(m.definition.name)+' · свой моб, Lv.'+m.definition.level+'</option>').join('')+'</select>'+button('＋ Добавить','add-enemy','',roster.length>=3)+'</div><ol class="rp-roster">'+roster.map((m,i)=>'<li><span>'+esc(m.name)+'</span>'+button('Убрать','remove-enemy:'+i,'small')+'</li>').join('')+'</ol>'+button('Создать и открыть встречу','create-encounter','primary',!roster.length)+'</section><div class="rp-section-title"><h2>Встречи чата</h2>'+button('Обновить','reload','small')+'</div><div class="rp-template-grid">'+result.encounters.map(r=>'<article class="rp-card"><span class="eyebrow">'+esc(({lobby:'СБОР ОТРЯДА',active:'ИДЁТ БОЙ',finished:'ЗАВЕРШЕНА',cancelled:'ОТМЕНЕНА'})[r.status]||r.status)+'</span><h3>'+r.roster.map(m=>esc(typeof m==='string'?catalog.mobs.find(x=>x.id===m)?.name||m:m.name)).join(', ')+'</h3><p>Раунд '+r.round+'</p>'+button('Открыть','encounter:'+r.token,'primary')+'</article>').join('')+(result.encounters.length?'':'<p class="muted">Здесь пока нет встреч.</p>')+'</div>');
    }
    async function refresh(){
      templates=(await request('/api/rp/templates')).templates;
      if(section==='encounters')await renderEncounters();else renderList();
    }
    function leaveEditor(){if(editing&&!confirm('Выйти из редактора? Несохранённые изменения пропадут.'))return false;editing=null;previewRequest++;clearTimeout(previewTimer);return true;}
    app.addEventListener('click',async event=>{
      const b=event.target.closest('[data-rp]');if(!b||b.disabled||busy)return;
      const [action,...args]=b.dataset.rp.split(':'),id=args.join(':');
      try{
        if(action==='section'){if(!leaveEditor())return;section=id;search='';filter='';if(section==='encounters')await renderEncounters();else renderList();return;}
        if(action==='reload'){if(!leaveEditor())return;busy=true;await refresh();return;}
        if(action==='back'){if(leaveEditor())renderList();return;}
        if(action==='new'){editing={definition:defaultValue()};search='';filter='';picker='skills';editor();return;}
        if(action==='edit'){editing=clone(templates.find(t=>t.id===id));editor();return;}
        if(action==='preset'){editing={definition:{...defaultValue(),...clone(catalog.mobs.find(m=>m.id===id).definition)}};editor();return;}
        if(action==='copy'){busy=true;const source=templates.find(t=>t.id===id),v=clone(source.definition);v.name=v.name.slice(0,70)+' · копия';await request('/api/rp/templates',{kind:source.kind,definition:v});await refresh();return;}
        if(action==='delete'){if(!confirm('Удалить шаблон? Уже начавшиеся бои не изменятся.'))return;busy=true;const t=templates.find(t=>t.id===id);await request('/api/rp/templates/'+id,{revision:t.revision},'DELETE');await refresh();return;}
        if(action==='save'){busy=true;b.disabled=true;await request('/api/rp/templates'+(editing.id?'/'+editing.id:''),{kind:section,definition:editing.definition,revision:editing.revision},editing.id?'PUT':'POST');editing=null;notice('RP-сборка сохранена.');await refresh();return;}
        if(action==='picker'){picker=id;editor();return;}
        if(action==='move'){const direction=Number(args.pop()),sid=args.join(':'),list=editing.definition.skills,index=list.indexOf(sid),other=index+direction;if(index>=0&&other>=0&&other<list.length)[list[index],list[other]]=[list[other],list[index]];renderSkills();return;}
        if(action==='reset-stats'){editing.definition.stats={};await preview();return;}
        if(action==='retry-preview'){schedulePreview();return;}
        if(action==='reset-art'){editing.definition.avatar_key=editing.definition.sprite_key='';editor();return;}
        if(action==='add-enemy'){if(roster.length>=3)return;const [kind,key]=document.getElementById('rp-enemy').value.split(':');roster.push({kind,id:key,name:kind==='builtin'?catalog.mobs.find(m=>m.id===key).name:templates.find(t=>t.id===key).definition.name});nonce=crypto.randomUUID();await renderEncounters();return;}
        if(action==='remove-enemy'){roster.splice(Number(id),1);nonce=crypto.randomUUID();await renderEncounters();return;}
        if(action==='create-encounter'){busy=true;b.disabled=true;const result=await request('/api/rp/encounters',{chat,roster:roster.map(({kind,id})=>({kind,id})),nonce});notice(result.notice);abort.abort();await onRaid(result.token);return;}
        if(action==='encounter'){abort.abort();await onRaid(id);}
      }catch(error){notice(error.message);b.disabled=false;}finally{busy=false;}
    },{signal:abort.signal});
    app.addEventListener('input',event=>{
      const el=event.target;
      if(el.id==='rp-search'){search=el.value;renderSkills();return;}
      if(!editing)return;
      if(el.dataset.stat){editing.definition.stats[el.dataset.stat]=Number(el.value);schedulePreview();return;}
      const key=el.dataset.field;if(!key)return;
      editing.definition[key]=fieldValue(el);
      if(key==='flip'||key==='scale')document.getElementById('rp-art').style.transform='scaleX('+(editing.definition.flip?-1:1)+') scale('+editing.definition.scale+')';
      schedulePreview();
    },{signal:abort.signal});
    app.addEventListener('change',async event=>{
      const el=event.target;
      try{
        if(el.id==='rp-chat'){if(!leaveEditor()){el.value=String(chat||'');return;}chat=el.value?Number(el.value):null;roster=[];nonce=crypto.randomUUID();if(section==='encounters')await renderEncounters();else renderList();return;}
        if(el.id==='rp-filter'){filter=el.value;renderSkills();return;}
        if(el.id==='rp-only'){onlySelected=el.checked;renderSkills();return;}
        if(!editing)return;
        if(el.dataset.field)editing.definition[el.dataset.field]=fieldValue(el);
        if(el.dataset.rpSkill){const ids=editing.definition[picker],id=el.dataset.rpSkill;if(el.checked&&!ids.includes(id))ids.push(id);if(!el.checked)editing.definition[picker]=ids.filter(k=>k!==id);renderSkills();schedulePreview();return;}
        if(['class_id','level','archclass_id','archclass_stage'].includes(el.dataset.field)){
          const v=editing.definition;if(v.level<10||el.dataset.field==='class_id')v.archclass_id='';if(v.level<20)v.archclass_stage=10;
          if(el.dataset.field==='class_id')for(const p of catalog.passives.filter(p=>p.class_id===v.class_id))if(!v.passives.includes(p.skill_id))v.passives.push(p.skill_id);
          editor();return;
        }
        if(el.id==='rp-avatar'||el.id==='rp-sprite'){
          const file=el.files?.[0];if(!file)return;if(file.size>2*1024*1024)throw Error('Максимум — 2 МБ.');
          const current=editing,kind=el.id==='rp-sprite'?'sprite':'avatar';busy=true;el.disabled=true;
          const response=await fetch('/api/rp/images?kind='+kind,{method:'POST',headers:{'X-Telegram-Init-Data':initData,'Content-Type':'image/png'},body:file});
          const result=await response.json();if(!response.ok)throw Error(result.error||'Ошибка изображения');
          if(editing===current){editing.definition[kind+'_key']=result.key;editor();}
        }
      }catch(error){notice(error.message);el.disabled=false;}finally{busy=false;}
    },{signal:abort.signal});
    abort.signal.addEventListener('abort',()=>{clearTimeout(previewTimer);previewRequest++;},{once:true});
    app.innerHTML='<div class="loading">Открываем RP-меню…</div>';
    const results=await Promise.all([request('/api/rp/catalog'),request('/api/rp/templates'),request('/api/rp/chats')]);
    if(abort.signal.aborted)return;
    catalog=results[0];templates=results[1].templates;chats=results[2].chats;
    if(!chats.some(c=>c.chat_id===chat))chat=null;
    renderList();
  }
})();
