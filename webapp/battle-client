    if(field&&data.data?.phase>=3){const scene=document.createElement('div');scene.className='chaplain-system-scene';scene.setAttribute('aria-hidden','true');scene.innerHTML='<div class="chaplain-background-clock">XII · III · VI · IX</div><span>REVISION.EXEC / TIME.RESTORE<br>ACCESS: '+(data.data.phase>=4?'ROOT':'RESTRICTED')+'<br>RESULT: NOT COMMITTED</span>';field.prepend(scene);}
    if(field&&data.data?.chaplain?.swap_target){const line=document.createElement('div');line.className='chaplain-swap-link';line.textContent='ПОДМЕНА ОБРАЗОВ · ИМЕНА И HP НЕ МЕНЯЮТСЯ';field.append(line);}
    if(data.data?.chaplain?.notification){const note=document.createElement('div');note.className='chaplain-system';note.setAttribute('role','status');note.textContent='SYSTEM › '+data.data.chaplain.notification;document.querySelector('.chaplain-regulation')?.prepend(note);}
  }
  updateRaidTimer();if(raidInspect)showRaidDetails(raidInspect);
  audio.refresh();
}
function raidNewEvents(previous,next){
  if(!previous?.data||previous.token!==next.token)return [];
  const last=Math.max(0,...previous.data.log.map(e=>Number(e.seq)||0));
  // Legacy records have no visual snapshots. Opening/reloading never replays history.
  const events=(next.data?.log||[]).filter(e=>e.seq>last&&e.after);
  // Long offline gaps jump to the authoritative state instead of playing a backlog.
  return events.length<=16&&(!last||!events.length||events[0].seq===last+1)?events:[];
}
function raidVisual(data,snapshot){
  const view=JSON.parse(JSON.stringify(data));
  for(const [key,values] of Object.entries(snapshot||{})){
    const f=key==='boss'?view.data.boss:view.data.enemies?.[key]||view.data.players[key]?.fighter;
    if(f)Object.assign(f,values);
  }
  if(view.boss_id==='kit'&&view.data.boss.mechanics?.kit_phase)view.data.phase=view.data.boss.mechanics.kit_phase;
  if(view.boss_id==='chaplain'&&view.data.boss.mechanics?.chaplain_phase)view.data.phase=view.data.boss.mechanics.chaplain_phase;
  raidPhaseSprite(view);
  return view;
}
function raidPopup(key,value){
  const el=document.getElementById('raid-fighter-'+key);if(!el||!value)return;
  const popup=document.createElement('span');popup.className='raid-damage';popup.textContent=typeof value==='number'?'−'+value:value;el.append(popup);
  setTimeout(()=>popup.remove(),950);
}
async function raidAnimate(event){
  if(['rewind','phase_restore','false_victory'].includes(event.chaplain_event)){
    const field=document.querySelector('.raid-field');
    if(field){const notice=document.createElement('div');notice.className='chaplain-revision';notice.setAttribute('role','status');notice.textContent=event.chaplain_event==='phase_restore'?'ВАШ РЕЗУЛЬТАТ НЕ БЫЛ СОХРАНЁН':event.chaplain_event==='false_victory'?'ПОБЕДА… НЕ УТВЕРЖДЕНА':'РЕДАКЦИЯ ОТМЕНЕНА';field.append(notice);field.classList.add('chaplain-rewinding');await sleep(reduced?650:1600);notice.remove();field.classList.remove('chaplain-rewinding');}
    return;
  }
  audio.actionStart(event);
  const actor=document.getElementById('raid-fighter-'+event.actor)?.querySelector('.raid-sprite');
  const target=document.getElementById('raid-fighter-'+event.target)?.querySelector('.raid-sprite');
  const field=document.querySelector('.raid-field');
  if(event.skill&&event.damage_type&&actor&&target&&event.actor!==event.target){
    if(event.damage_type==='magic'&&field){
      const a=actor.getBoundingClientRect(),t=target.getBoundingClientRect(),r=field.getBoundingClientRect();
      const orb=document.createElement('span');orb.className='raid-projectile';field.append(orb);
      orb.style.left=(a.x+a.width/2-r.x)+'px';orb.style.top=(a.y+a.height/2-r.y)+'px';
      if(!reduced)await orb.animate([{transform:'translate(0,0)'},{transform:'translate('+(t.x+t.width/2-a.x-a.width/2)+'px,'+(t.y+t.height/2-a.y-a.height/2)+'px)'}],{duration:350,easing:'ease-in'}).finished;
      orb.remove();
    }else{
      actor.classList.add(event.actor==='boss'||raidCurrent.data.enemies?.[event.actor]?'raid-strike-left':'raid-strike-right');await sleep(350);
      actor.classList.remove('raid-strike-left','raid-strike-right');
    }
  }else if(event.skill&&actor){
    actor.classList.add('raid-cast');await sleep(350);actor.classList.remove('raid-cast');
  }
  audio.impact(event);
  if(event.hit_results||event.damage){
    for(const [i,amount] of (event.hits||[event.damage]).entries()){
      const part=event.hit_results?.[i],landed=part?part.hit:amount>0;
      if(landed&&amount)target?.classList.add('raid-hit');raidPopup(event.target,part&&!landed?(part.blocked?'Блок':part.dodged?'Уклонение':'Промах'):amount);
      if(event.hits){if(landed&&amount)await slashImpact(target);else await sleep(190);target?.classList.remove('raid-hit');}
    }
  }
  if(event.self_damage||event.bleed_damage){actor?.classList.add('raid-hit');raidPopup(event.actor,(event.self_damage||0)+(event.bleed_damage||0));}
  await sleep(450);target?.classList.remove('raid-hit');actor?.classList.remove('raid-hit');
}
async function slashImpact(target){
  const host=target?.parentElement;if(!host)return;
  const slash=document.createElement('span');slash.className='combat-slash';host.append(slash);
  const t=target.getBoundingClientRect(),h=host.getBoundingClientRect();
  slash.style.left=(t.x-h.x+t.width*.15)+'px';slash.style.top=(t.y-h.y+t.height*.45)+'px';slash.style.width=(t.width*.7)+'px';
  await sleep(190);slash.remove();
}
async function receiveRaid(data){
  const previous=raidCurrent,events=raidNewEvents(previous,data);
  if(!events.length){raidScreen(data);return;}
  raidPlaying=true;
  try{
    const intentHeight=document.querySelector('.raid-intent')?.getBoundingClientRect().height||0;
    let snapshot=events[0].before||{boss:previous.data.boss,...Object.fromEntries(Object.entries(previous.data.players).map(([k,p])=>[k,p.fighter]))};
    for(const e of events){
      if(raidCurrent?.token!==data.token)return;
      const frame=raidVisual(data,e.before||snapshot);
      frame.data.round=e.round;frame.data.intent={text:'Разыгрывается раунд',targets:[]};
      frame.data.dialogue=e.dialogue?{speaker:data.boss_id==='whaler'?'КИТОБОЙ':'ФУФЕЛШМЕРЦ',text:e.dialogue,warning:'',persistent:false}:null;
      frame.data.log=frame.data.log.filter(item=>!item.seq||item.seq<=e.seq);
      raidScreen(frame);
      const intent=document.querySelector('.raid-intent');if(intent)intent.style.minHeight=intentHeight+'px';
      const panel=document.querySelector('.raid-actions');
      if(panel){panel.style.minHeight=panel.getBoundingClientRect().height+'px';panel.setAttribute('aria-live','polite');panel.innerHTML='<div class="battlelog"><b>'+esc(raidName(data,e.actor))+'</b><br>'+esc(e.text)+'</div>';}
      await raidAnimate(e);snapshot=e.after;
      if(e.dialogue&&!reduced)await sleep(1500);
      // Apply each outcome before the next action rather than jumping to final HP.
      for(const [key,values] of Object.entries(snapshot)){
        const f=key==='boss'?frame.data.boss:frame.data.enemies?.[key]||frame.data.players[key]?.fighter;
        if(f)Object.assign(f,values);
        const el=document.getElementById('raid-fighter-'+key);
        if(el&&f){const enemyIndex=Object.keys(frame.data.enemies||{}).indexOf(key),i=Object.keys(frame.data.players).indexOf(key);el.outerHTML=enemyIndex>=0?encounterPortrait(f,key,enemyIndex):raidPortrait(f,key,frame.data.players[key],i);}
      }
      await sleep(300);
    }
  }finally{
    raidPlaying=false;
    if(raidCurrent?.token===data.token)raidScreen(data);
    if(previous.status==='active'&&data.status==='finished')audio.effect(data.data.won?'victory':'defeat');
  }
}
function updateRaidTimer(){const el=document.getElementById('raid-timer');if(!el||!raidCurrent||raidCurrent.status!=='active')return;if(raidPlaying){el.textContent='Разыгрывается раунд';el.classList.remove('urgent');return;}const left=Math.max(0,Math.ceil((raidCurrent.deadline*1000-Date.now()-serverClockOffset)/1000));el.textContent='Выбор действий: '+Math.floor(left/60)+':'+String(left%60).padStart(2,'0');el.classList.toggle('urgent',left<=20);}
let raidDetailsCutTimer=null;
