let inspectSide=null,classUsePending=null,skillUsePending=null;
const rarityNames={common:"Обычный",uncommon:"Необычный",rare:"Редкий",epic:"Эпический"};
const statNames={max_hp:"Макс. HP",resource_max:"Макс. энергия",physical_attack:"Физ. атака",magic_attack:"Маг. атака",physical_defense:"Физ. защита",magic_defense:"Маг. защита",speed:"Скорость",evasion:"Уклонение"};
const effectNames={accuracy_flat:"Точность",damage_pct:"Урон",speed_pct:"Скорость",physical_defense_pct:"Физ. защита",magic_defense_pct:"Маг. защита",evasion_flat:"Уклонение",resource:"Энергия",stun:"Ошеломление"};
const esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const sleep=ms=>new Promise(resolve=>setTimeout(resolve,reduced?Math.min(50,ms):ms));
const sprite=c=>c&&typeof c==="object"&&/^\/sprites\/[0-9a-f]{64}\.png$/.test(c.sprite_url||"")?c.sprite_url:"/static/assets/"+(["cutie","jock","nerd"].includes(typeof c==="object"?c?.sprite:c)?(typeof c==="object"?c.sprite:c):"ragamuffin")+".png";
function fighterImage(p,cls="",id=""){
  return '<img class="'+cls+(p.sprite_url&&p.pixel_art?' pixel-art':'')+'"'+(id?' id="'+id+'"':'')+' src="'+sprite(p)+'" data-fallback="'+sprite(p.sprite)+'" alt="'+esc(p.class_name)+'">';
}
function clearSpriteDraft(){if(spriteDraft)URL.revokeObjectURL(spriteDraft.url);spriteDraft=null;}
function rarityBadge(r){return '<span class="rarity '+(Object.hasOwn(rarityNames,r)?r:"common")+'">'+esc(rarityNames[r]||r||"Обычный")+'</span>';}
function describeEffect(e){const value=e.kind.endsWith("_pct")?Math.round(e.value*100)+"%":e.value;return esc(effectNames[e.kind]||e.kind)+': '+(e.value>0?'+':'')+esc(value)+(e.target==='enemy'?' противнику':'')+(e.turns?' · '+e.turns+' х.':'')+(e.chance<1?' · шанс '+Math.round(e.chance*100)+'%':'');}
function skillInfo(s){return '<div class="muted">'+(s.cost!==undefined?'Энергия '+s.cost+' · точность '+s.accuracy+'% · сила '+s.power+' · перезарядка '+s.cooldown+' х.':'')+'</div>'+((s.effects||[]).map(e=>'<div class="muted">'+describeEffect(e)+'</div>').join(''));}
function itemInfo(item){const d=item.details||{};return d.description?'<p class="muted">'+esc(d.description)+'</p>':item.kind==='class'?'<p class="muted">Меняет класс, сбрасывает уровень до 1, весь опыт, изученные активные и пассивные навыки. Инвентарь и спрайт сохраняются.</p>':'<p class="muted">'+(item.kind==='passive'?'Пассивный навык · максимум 2 в бою':'Активный навык · нужен уровень '+(d.unlock_level||1))+'</p>'+skillInfo(d);}
function fighterDetails(s,key){
  const effective=s.effective_stats||s.stats;
  return '<div class="profile fighter-detail">'+fighterImage(s)+'<div><h2>'+esc(s.name)+'</h2><div class="muted">'+esc(s.class_name)+' · Lv.'+s.level+'</div>'+rarityBadge(s.class_rarity)+'<p>HP '+s.hp+' / '+s.stats.max_hp+'<br>'+esc(s.resource_name)+': '+s.resource+' / '+s.stats.resource_max+'</p></div></div><div class="stats-grid">'+Object.entries(statNames).map(([id,label])=>'<div><span>'+label+'</span><b>'+esc(Math.round((effective[id]??s.stats[id]??0)*100)/100)+(effective[id]!==s.stats[id]?' <small>(база '+esc(s.stats[id])+')</small>':'')+'</b></div>').join('')+'</div><p class="muted">'+(s.controlled?'Контроль: все характеристики −20%. ':'')+'Бонус точности: '+(s.accuracy_bonus||0)+' · бонус урона: '+Math.round((s.damage_bonus||0)*100)+'%.<br>Автоматического восстановления энергии нет. Уклонение и точность указаны в процентных пунктах.</p><h3>Активные навыки</h3>'+s.skill_details.map(skill=>'<div class="detail-skill"><b>'+esc(skill.name)+'</b> '+rarityBadge(skill.rarity)+skillInfo(skill)+(s.cooldowns[skill.skill_id]?'<div class="muted">Восстановится через '+s.cooldowns[skill.skill_id]+' х.</div>':'')+'</div>').join('')+'<h3>Пассивные навыки · '+(s.passive_details||[]).length+' / 2</h3>'+((s.passive_details||[]).map(p=>'<div class="detail-skill"><b>'+esc(p.name)+'</b> '+rarityBadge(p.rarity)+skillInfo(p)+'</div>').join('')||'<p class="muted">Не экипированы.</p>')+'<h3>Эффекты</h3>'+((s.effects||[]).filter(e=>e.duration<10000).map(e=>'<p class="muted">'+describeEffect(e)+' · осталось '+e.duration+' х.</p>').join('')||'<p class="muted">Нет временных эффектов.</p>')+'<p class="muted">Владелец/игрок: '+esc(current?.names?.[key+'_owner']||s.name)+'</p>';
}
function closeStats(){const key=inspectSide,overlay=document.getElementById('fighter-stats');if(overlay){overlay.close();overlay.remove();}document.documentElement.classList.remove('fighter-details-open');app.inert=false;inspectSide=null;if(key)app.querySelector('[data-inspect="'+key+'"]')?.focus({preventScroll:true});}
function showStats(key){
  const s=current?.state?.sides[key];if(!s)return;inspectSide=key;
  let overlay=document.getElementById('fighter-stats');
  const fresh=!overlay;
  if(fresh){
    overlay=document.createElement('dialog');overlay.id='fighter-stats';overlay.className='stats-dialog';overlay.setAttribute('aria-label','Статистика бойца');
    overlay.addEventListener('cancel',e=>{e.preventDefault();closeStats();});
    overlay.addEventListener('click',e=>{const r=overlay.getBoundingClientRect();if(e.target.closest('[data-close-stats]')||(e.target===overlay&&(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)))closeStats();});document.body.append(overlay);
  }
  const scroll=overlay.scrollTop;
  overlay.innerHTML='<header class="stats-header"><b>О бойце</b><button class="small close-stats" data-close-stats aria-label="Закрыть детали">Закрыть ✕</button></header>'+fighterDetails(s,key);
  overlay.scrollTop=scroll;
  if(fresh){overlay.showModal();document.documentElement.classList.add('fighter-details-open');overlay.querySelector('[data-close-stats]').focus({preventScroll:true});}
}
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeStats();});
function toast(text){const box=document.getElementById("toast");box.textContent=text;box.hidden=false;setTimeout(()=>box.hidden=true,3500);}
function button(label,id,cls="",disabled=false){return '<button class="'+cls+'" data-do="'+id+'"'+(disabled?' disabled':'')+'>'+label+"</button>";}
function top(title,tag,right){return '<header class="top"><div><div class="eyebrow">'+tag+'</div><h1>'+title+'</h1></div>'+right+"</header>";}
async function api(path,body){
  const response=await fetch(path,{method:body?"POST":"GET",headers:{"Content-Type":"application/json","X-Telegram-Init-Data":tg?.initData||""},body:body?JSON.stringify(body):undefined,cache:"no-store"});
  const data=await response.json();
  if(!response.ok)throw new Error(data.error||"Сервер недоступен.");
  return data;
}
function hud(s,key){
  return '<div class="hud '+(key===near?"player":"enemy")+'"><div class="row"><div class="name">'+esc(s.name)+'</div><span class="badge">Lv.'+s.level+'</span><button class="stat-button" data-inspect="'+key+'" aria-label="Статистика '+esc(s.name)+'">ⓘ</button></div><div class="meta">'+esc(s.class_name)+(s.controlled?" · контроль −20%":"")+'</div><div class="barline"><span>HP</span><span id="hp-'+key+'">'+s.hp+" / "+s.stats.max_hp+'</span></div><div class="bar" id="health-'+key+'"><i style="width:'+100*s.hp/s.stats.max_hp+'%"></i></div><div class="barline"><span>'+esc(s.resource_name)+'</span><span id="mp-'+key+'">'+s.resource+" / "+s.stats.resource_max+'</span></div><div class="bar mana" id="mana-'+key+'"><i style="width:'+100*s.resource/s.stats.resource_max+'%"></i></div></div>';
}
function battleScreen(data){
  current=data; token=data.token; chat=data.chat_id;
  if(!data.state||!["active","finished"].includes(data.status)){setupScreen(data);return;}
  near=(data.own_side==="b"||(!data.own_side&&(data.state.sides.b.controller_id===data.actor_id||data.consent_side==="b")))?"b":"a";
  const far=near==="a"?"b":"a",a=data.state.sides[near],b=data.state.sides[far];
  app.innerHTML='<section class="battle">'+top("Арена",data.mode==="wasteland"?"ПУСТОШЬ · ЭТАЖ "+data.floor:"ГНИДА · ПОШАГОВЫЕ БОИ",'<span class="pill">'+(demo?"ДЕМО":data.stake?data.stake+" ₣":"БЕЗ СТАВКИ")+'</span>')+
    '<div class="field">'+hud(b,far)+'<div class="podium enemy"></div>'+fighterImage(b,"sprite enemy","sprite-"+far)+'<div class="podium player"></div>'+fighterImage(a,"sprite player","sprite-"+near)+hud(a,near)+'</div><div class="turnbanner" id="turn"></div><section class="panel" id="panel" aria-live="polite"></section><footer class="foot"><span id="round">ХОД '+data.state.turn+'</span>'+button("В меню","menu","small")+'</footer></section>';
  renderActions();
  if(inspectSide)showStats(inspectSide);
}
function renderActions(){
  if(!current?.state||!document.getElementById("panel"))return;
  const st=current.state,side=st.sides[st.active_side],mine=side.controller_id===current.actor_id;
  document.getElementById("round").textContent="ХОД "+st.turn;
  document.getElementById("turn").textContent=st.finished?"Бой завершён":mine?"Твой ход · выбери навык":side.name+" выбирает навык";
  const panel=document.getElementById("panel");
  if(st.finished){
    const winner=st.winner?st.sides[st.winner].name:"";
    panel.innerHTML='<div class="battlelog">'+(winner?"Победа: "+esc(winner):"Ничья")+'<div class="muted">Опыт: '+Object.values(st.rewards||{}).join(" / ")+' XP'+(st.payout?" · Приз "+st.payout+" ₣":"")+'</div></div>'+
      (current.mode==="wasteland"&&st.winner==="a"?button("Следующий этаж","next","primary"):"");
    for(const k of ["a","b"])document.getElementById("sprite-"+k).classList.toggle("defeated",st.sides[k].hp===0);
  }else if(mine){
    panel.innerHTML='<div class="skills">'+side.skill_details.map(skill=>'<button class="skill" data-skill="'+esc(skill.skill_id)+'" '+(side.resource<skill.cost||side.cooldowns[skill.skill_id]?"disabled":"")+'><span class="type">'+(skill.damage_type==="magic"?"МАГИЯ":skill.damage_type==="physical"?"АТАКА":"ЭФФЕКТ")+'</span>'+esc(skill.name)+'<span>'+skill.cost+' '+esc(side.resource_name)+(side.cooldowns[skill.skill_id]?" · ещё "+side.cooldowns[skill.skill_id]+" х.":"")+"</span></button>").join("")+'</div>';
    panel.innerHTML+='<div class="row" style="margin-top:8px">'+(side.can_use_potion&&!side.potion_used?button("Зелье · 30% HP","potion","small"):"<span></span>")+button("Сдаться","surrender","small danger")+'</div>';
  }else{
    panel.innerHTML='<div class="battlelog">'+(current.own_side||current.consent_side?"Ход соперника…":"Ты наблюдаешь за боем.")+'<div class="muted">'+esc(st.log.at(-1)?.text||"Первый ход скоро начнётся.")+'</div></div>';
  }
}
function setupScreen(data){
  const status={cancelled:"Вызов отменён",expired:"Время вызова истекло",refused:"Вызов отклонён"};
  app.innerHTML='<section class="menu">'+top("Подготовка боя","АРЕНА",button("Меню","menu","small"))+'<div class="content"><div class="card"><h2>'+esc(data.names.a_owner)+' × '+esc(data.names.b_owner)+'</h2><p class="muted">'+(status[data.status]||(data.mode==="personal"?"Личный бой. Ждём принятия вызова соперником.":"Соперник принимает вызов, каждый владелец выбирает своего бойца."))+'</p><div id="setup" class="stack"></div></div></div></section>';
  const box=document.getElementById("setup");if(data.status!=="pending")return;
  if(data.own_side==="b"&&!data.b_accepted)box.innerHTML+=button("Принять"+(data.stake?" · "+data.stake+" ₣":""),"accept","primary")+button("Отклонить","refuse");
  if(data.mode==="slaves"&&data.own_side){
    const key=data.own_side;
    box.innerHTML+='<label class="check"><input type="checkbox" id="control" checked> Управлять самому · все характеристики −20%</label><div class="muted">Без контроля раб должен согласиться и самостоятельно выбирать навыки.</div>';
    box.innerHTML+=data.available.map(s=>button(esc(s.name)+" · Lv."+s.level,(s.id===data[key+"_fighter"]?"selected:":"select:")+s.id,s.id===data[key+"_fighter"]?"primary":"")).join("");
    if(!data.available.length)box.innerHTML+='<div class="note">Нет экипированных бойцов. Открой меню → Рабы и займи свободный боевой слот. При экипировке раб снимается с работы.</div>';
  }
  if(data.consent_side&&!data[data.consent_side+"_consent"])box.innerHTML+=button("Согласен сражаться сам","consent","primary");
  if(data.own_side==="a")box.innerHTML+=button("Отменить вызов","cancel","danger");
  box.innerHTML+='<div class="muted">'+(data.mode==="personal"?"Бой начнётся сразу после принятия вызова.":"Бой начнётся после принятия вызова и выбора обоих бойцов.")+' Никаких подтверждений навыков в бою.</div>';
}
async function animateEvent(event){
  const panel=document.getElementById("panel"); if(!panel)return;
  const userTurn=current.state.sides[event.side]?.controller_id===current.actor_id;
  document.getElementById("turn").textContent=userTurn?"Твой ход":"Ход: "+current.state.sides[event.side].name;
  document.getElementById("round").textContent="ХОД "+event.seq;
  panel.innerHTML='<div class="battlelog">'+esc(event.skill_name||event.text)+'</div>';
  const attacker=document.getElementById("sprite-"+event.side);
  const other=event.side==="a"?"b":"a",target=document.getElementById("sprite-"+other);
  attacker?.classList.add("attack");
  if(event.damage_type==="magic"){
    const projectile=document.createElement("div");projectile.className="projectile";projectile.style.animation=(event.side===near?"projectile":"enemyProjectile")+" .5s forwards";
    document.querySelector(".field").append(projectile);setTimeout(()=>projectile.remove(),600);
  }
  await sleep(430);attacker?.classList.remove("attack");
  if(event.hit&&event.damage){target?.classList.add("hurt");const number=document.createElement("div");number.className="damage";number.textContent="−"+event.damage;if(other===near){number.style.left="23%";number.style.top="65%";}document.querySelector(".field").append(number);setTimeout(()=>number.remove(),1000);}
  if(event.after)for(const key of ["a","b"]){
    const s=current.state.sides[key],values=event.after[key];
    document.getElementById("health-"+key).firstElementChild.style.width=100*values.hp/s.stats.max_hp+"%";
    document.getElementById("health-"+key).classList.toggle("low",values.hp/s.stats.max_hp<.3);
    document.getElementById("hp-"+key).textContent=values.hp+" / "+s.stats.max_hp;
    document.getElementById("mana-"+key).firstElementChild.style.width=100*values.resource/s.stats.resource_max+"%";
    document.getElementById("mp-"+key).textContent=values.resource+" / "+s.stats.resource_max;
  }
  await sleep(450);target?.classList.remove("hurt");panel.innerHTML='<div class="battlelog">'+esc(event.text)+'</div>';await sleep(700);
}
async function applyBattle(data,animate=true){
  if(current&&data.token===current.token&&data.revision<current.revision)return;
  const events=data.state?.log.filter(e=>e.seq>lastSeq)||[];
  if(!current?.state||!data.state){lastSeq=data.state?.log.at(-1)?.seq||0;battleScreen(data);return;}
  current=data;
  if(animate){
    for(const event of events){await animateEvent(event);lastSeq=event.seq;}
  }else lastSeq=data.state.log.at(-1)?.seq||0;
  battleScreen(data);
}
async function action(action,extra={}){
  if(busy)return;busy=true;
  document.querySelectorAll("#panel button,#setup button").forEach(b=>b.disabled=true);
  try{
    let data;
    if(demo){
      const key=current.state.active_side,other=key==="a"?"b":"a",s=current.state.sides;
      const used=s[key].skill_details.find(x=>x.skill_id===extra.skill)||s[key].skill_details[0];
      s[other].hp=Math.max(0,s[other].hp-12);
      current.state.log.push({seq:current.state.turn++,side:key,skill_name:used.name,damage_type:used.damage_type,text:"Попадание · −12 HP",hit:true,damage:12,after:{a:{hp:s.a.hp,resource:s.a.resource},b:{hp:s.b.hp,resource:s.b.resource}}});
      current.state.active_side=other;current.revision++;data=current;
      if(!current.state.finished){
        const enemyMove=s[other].skill_details[0];s[key].hp=Math.max(0,s[key].hp-8);
        current.state.log.push({seq:current.state.turn++,side:other,skill_name:enemyMove.name,damage_type:"physical",text:"Ответ противника · −8 HP",hit:true,damage:8,after:{a:{hp:s.a.hp,resource:s.a.resource},b:{hp:s.b.hp,resource:s.b.resource}}});
        current.state.active_side=key;
      }
    }else data=await api("/api/battle/"+token,{action,revision:current.revision,...extra});
    await applyBattle(data);
  }catch(error){toast(error.message);if(!demo)try{await applyBattle(await api("/api/battle/"+token),false);}catch{}}
  finally{busy=false;renderActions();}
}
function profileCard(p,title,owned=false){
  const progress=p.progress||[p.level,0,10];
  const maxed=p.level>=20;
  const status=p.personal?"":'<p class="muted">'+(p.combat_slot?"Боевой слот "+p.combat_slot+" / 5":p.working_role?"На работе · не экипирован":"Вне боевого отряда")+(p.in_battle?" · выбран для боя":"")+'</p>';
  const equipment=owned?button(p.combat_slot?"Снять с боевого слота":"Экипировать и снять с работы",(p.combat_slot?"unequip:":"equip:")+p.user_id,"",p.in_battle):"";
  return '<div class="card"><div class="profile">'+fighterImage(p)+'<div><div class="eyebrow">'+title+'</div><h2>'+esc(p.name||p.class_name)+'</h2><div class="muted">'+esc(p.class_name)+' · уровень '+p.level+'</div><div class="xp"><div class="barline"><span>ОПЫТ</span><span>'+(maxed?'МАКСИМУМ · 20':progress[1]+' / '+progress[2]+' XP')+'</span></div><div class="bar"><i style="width:'+(maxed?100:100*progress[1]/progress[2])+'%"></i></div></div></div></div>'+status+'<div class="stack">'+button("В Пустошь", "waste:"+p.user_id,"primary",!p.personal&&!p.combat_slot)+button("Класс и навыки","profile:"+p.user_id)+equipment+(p.can_edit_sprite?button("Свой спрайт","appearance"):"")+'</div></div>';
}
function activeProfile(){return [...(menu?.slaves||[]),menu?.self_slave,menu?.personal].filter(Boolean).find(p=>p.user_id===profileId&&p.personal===(page==="personalProfile"));}
function menuScreen(data){
  menu=data;chat=data.chat_id;token="";
  if(page!=="appearance")clearSpriteDraft();
  let body='<div class="tabs">'+button("Персонаж","tab:personal",page==="personal"?"selected":"")+button("Рабы","tab:slaves",page==="slaves"?"selected":"")+button("Владелец","tab:owner",page==="owner"?"selected":"")+'</div><div class="tabs">'+button("Инвентарь","tab:inventory",page==="inventory"?"selected":"")+button("Торговец","tab:merchant",page==="merchant"?"selected":"")+'</div>';
  if(page==="personal")body+=profileCard(data.personal,"ЛИЧНЫЙ ПЕРСОНАЖ")+'<div class="note">Вызови любого: <b>/бой @участник</b> или ответом <b>/бой</b>. Личный персонаж есть у всех, раб не нужен. Можно добавить ставку: <b>/бой @участник 50</b>. Бои здесь не передают рабов.</div>';
  else if(page==="slaves"){
    body+='<div class="card"><h2>Боевой отряд · '+data.combat_count+' / '+data.combat_capacity+'</h2><p class="muted">При экипировке раб снимается с работы. Чтобы вернуть его на предприятие, сначала сними с боевого слота.</p></div>';
    for(let slot=1;slot<=data.combat_capacity;slot++){
      const p=data.slaves.find(s=>s.combat_slot===slot);
      body+=p?profileCard(p,"БОЕВОЙ СЛОТ "+slot,true):'<div class="card"><div class="muted">Слот '+slot+' · свободен</div></div>';
    }
    const reserve=data.slaves.filter(p=>!p.combat_slot);
    if(reserve.length)body+='<h2>Остальные рабы</h2>'+reserve.map(p=>profileCard(p,"ВНЕ ОТРЯДА",true)).join("");
    if(!data.slaves.length)body+='<div class="note">Пока нет рабов. Личный персонаж доступен всем.</div>';
    if(data.self_slave)body+=profileCard(data.self_slave,"ТВОЙ ПЕРСОНАЖ-РАБ");
    body+='<div class="note">Ответь владельцу <b>/бой рабами</b> или напиши <b>Я выбираю тебя @раб</b>. Каждый владелец выбирает экипированного бойца. Без контроля раб должен согласиться; контроль доступен с 1 уровня.</div>';
