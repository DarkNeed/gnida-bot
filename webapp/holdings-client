"use strict";
/* Separate controller: ownership is chat-local and never uses arena profile APIs. */
window.HoldingsApp=(()=>{
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const number=v=>Number(v||0).toLocaleString('ru-RU');
  const duration=s=>s<3600?Math.round(s/60)+' мин':s/3600+' ч';
  const date=s=>new Date(s*1000).toLocaleString('ru-RU');
  const rarities={common:'обычной',uncommon:'необычной',rare:'редкой'};
  let app,api,onArena,demo=false,data=null,chats=[],tab='sites',siteId=null,selected=new Set(),filter='all',search='',page=0,
      mission=null,quote=null,pending=false,timer=null,offset=0,pickerSite=null,refreshAt=0,dialog=null,requestGeneration=0;
  function active(){return Boolean(app?.querySelector('.holdings'))}
  function stamp(){return Math.floor((Date.now()+offset)/1000)}
  function nonce(){const b=new Uint8Array(16);crypto.getRandomValues(b);return Array.from(b,x=>x.toString(16).padStart(2,'0')).join('')}
  function image(p){const u=p.avatar_url||'/static/assets/ragamuffin.png';return /^\/(sprites\/[0-9a-f]{64}\.png|static\/assets\/[a-z_/]+\.png)$/.test(u)?u:'/static/assets/ragamuffin.png'}
  function button(label,action,primary=false,disabled=false){return '<button type="button" data-h="'+action+'"'+(primary?' class="primary"':'')+(disabled?' disabled':'')+'>'+label+'</button>'}
  function notice(text,error=false){const n=app.querySelector('#holdings-notice');if(n){n.textContent=text;n.hidden=false;n.classList.toggle('holdings-error',error)}}
  function free(p){return !p.business_id&&!p.away&&!p.expedition_active}
  function unavailable(p){return p.away||p.expedition_active||mission&&p.expedition_ready_at>stamp()}
  function site(id){return data?.sites.find(s=>s.id===Number(id))}
  function available(p){return !unavailable(p)&&(!pickerSite||p.business_id!==pickerSite)}
  function siteCard(s){const count=s.workers.length,away=s.workers.filter(w=>w.away).length;return '<article class="holdings-site"><div class="holdings-site-top"><div><span class="holdings-kind">'+esc(s.emoji)+' '+esc(s.type_name)+'</span><h2>'+esc(s.title)+'</h2></div><span class="pill">Ур. '+s.level+'</span></div><div class="holdings-meter-label"><span>Работники <b>'+count+' / '+s.capacity+'</b>'+(away?' · отсутствуют '+away:'')+'</span><span>Мест: '+Math.max(0,s.capacity-count)+'</span></div><div class="holdings-meter"><span style="width:'+Math.min(100,count/s.capacity*100)+'%"></span></div><div class="holdings-buttons">'+button('Управлять','site:'+s.id)+button('Добавить работников','fill:'+s.id,true,count>=s.capacity)+'</div></article>'}
  function summary(){const working=data.people.filter(p=>p.business_id&&!p.away).length;return '<div class="holdings-summary"><div><small>Всего рабов</small><strong>'+data.people.length+'</strong></div><div><small>На работе</small><strong>'+working+'</strong></div><div><small>Без работы</small><strong>'+data.people.filter(free).length+'</strong></div></div>'}
  function personRow(p,staff=false){const work=site(p.business_id),blocked=unavailable(p),cooldown=p.expedition_ready_at>stamp(),job=p.expedition_active?'В экспедиции':p.away?'Пропал':staff?(work&&p.role===role(work,true)?work.leader_label:work?.producer_label||'Работник'):work?.title||'Без работы';return '<label class="holdings-person"><input type="checkbox" data-h-person="'+p.user_id+'" aria-label="Выбрать '+esc(p.name)+'"'+(selected.has(p.user_id)?' checked':'')+(blocked?' disabled':'')+'><img src="'+esc(image(p))+'" alt="" loading="lazy"><span class="holdings-person-info"><b>'+esc(p.name)+'</b><small>'+esc(p.class_name)+' · ур. '+p.level+' · сила '+p.power+'</small>'+(mission&&cooldown?'<small>Следующий поход: '+esc(date(p.expedition_ready_at))+'</small>':'')+'</span><span class="holdings-job'+(free(p)?' free':'')+'">'+esc(job)+'</span></label>'}
  function role(s,leader){return s.business_type==='brothel'?(leader?'manager':'courtesan'):s.business_type==='field'?(leader?'overseer':'collector'):(leader?'leader':'worker')}
  function roster(people,staff=false){const rows=people.filter(p=>(!search||(p.name+' '+(p.username||'')).toLowerCase().includes(search.toLowerCase()))&&(filter==='all'||filter==='free'&&free(p)||filter==='working'&&p.business_id&&!p.away||filter==='away'&&(p.away||p.expedition_active)));if(mission)rows.sort((a,b)=>b.power-a.power||a.user_id-b.user_id);page=Math.min(page,Math.max(0,Math.ceil(rows.length/10)-1));return '<div class="holdings-toolbar"><input id="holdings-search" type="search" placeholder="Имя или @тег" aria-label="Найти участника" value="'+esc(search)+'"><select id="holdings-filter" aria-label="Занятость">'+[['all','Все'],['free','Без работы'],['working','Работают'],['away','Отсутствуют']].map(([v,n])=>'<option value="'+v+'"'+(filter===v?' selected':'')+'>'+n+'</option>').join('')+'</select></div><div class="holdings-select-row">'+button('Выбрать на странице','select-page')+button('Снять выбор','clear',false,!selected.size)+'<span>'+rows.length+' участников</span></div><div class="holdings-roster">'+(rows.slice(page*10,page*10+10).map(p=>personRow(p,staff)).join('')||'<p class="holdings-empty">Никого не найдено</p>')+'</div><div class="holdings-pager">'+button('←','prev',false,page===0)+'<span>'+(rows.length?page*10+1:0)+'–'+Math.min(rows.length,page*10+10)+' из '+rows.length+'</span>'+button('→','next',false,(page+1)*10>=rows.length)+'</div>'}
  function bulk(){return '<div class="holdings-bulk"><b>Выбрано: '+selected.size+(mission?' / 5':'')+'</b>'+button(mission?'Проверить отряд':'Назначить',mission?'quote':'assign',true,!selected.size||pending)+(mission?'':button('Снять с работ','remove',false,!selected.size||pending))+'</div>'}
  function overview(){let body=summary();if(data.recoveries.length)body+='<div class="note">🚨 Пропавших рабов: '+data.recoveries.length+'. Верни их через сообщение мини-игры в боте — таймер уже идёт.</div>';const slots=data.sites.reduce((n,s)=>n+Math.max(0,s.capacity-s.workers.length),0);body+='<div class="note">Без работы: '+data.people.filter(free).length+' · свободных мест: '+slots+'.</div><div class="holdings-buttons">'+button('Распределить свободных','free-workers',true)+button('Собрать экспедицию','raids',false,!data.arena_enabled)+'</div>';return body+data.sites.map(siteCard).join('')}
  function details(s){const income=s.income.reduce((n,r)=>n+r.net_income,0);return '<div class="holdings-section-head"><div><span class="holdings-kind">'+esc(s.emoji)+' '+esc(s.type_name)+' · ур. '+s.level+'</span><h2>'+esc(s.title)+'</h2></div>'+button('←','back-sites')+'</div>'+(s.description?'<p class="holdings-description">'+esc(s.description)+'</p>':'')+'<p class="muted">Места '+s.workers.length+'/'+s.capacity+' · активный работник '+s.active_rate+' ₣/ч, неактивный '+s.inactive_rate+' ₣/ч до налога. Управляющий +20% активной выручки.</p><div class="holdings-buttons">'+button('Добавить работников','fill:'+s.id,true,s.workers.length>=s.capacity)+button('Заполнить свободными','auto:'+s.id,false,s.workers.length>=s.capacity||!data.people.some(free))+'</div>'+roster(data.people.filter(p=>p.business_id===s.id),true)+bulk()+'<details class="holdings-settings"><summary>Оформление и управление</summary><div class="holdings-buttons">'+button('Название','edit:'+s.id+':name')+button('Описание','edit:'+s.id+':description')+(s.business_type==='custom'?button('Должность работника','edit:'+s.id+':producer_title')+button('Должность управляющего','edit:'+s.id+':leader_title'):'')+(s.upgrade_price?button('Расширить · '+s.upgrade_price+' ₣','upgrade:'+s.id):'')+'</div><p class="muted">Чистый доход за последние 7 записанных дней: '+number(income)+' ₣.</p><button type="button" class="danger" data-h="close:'+s.id+'">Закрыть предприятие</button></details>'}
  function sitesScreen(){if(siteId&&site(siteId))return details(site(siteId));siteId=null;return '<div class="holdings-section-head"><div><h2>Предприятия</h2><p class="muted">'+data.sites.length+' / '+data.max_enterprises+' · разных типов</p></div>'+button('＋ Открыть','create',true,data.sites.length>=data.max_enterprises)+'</div>'+(data.sites.map(siteCard).join('')||'<p class="holdings-empty">Пока нет предприятий. Открой первое и назначь работников.</p>')}
  function expeditionCard(r){const q=r.quote,m=data.missions.find(m=>m.id===r.mission),active=r.status==='active',res=r.result;return '<article class="holdings-site"><div class="holdings-section-head"><h3>'+esc(m?.name||q.name)+'</h3><span class="pill">'+(active?'В пути':r.status==='cancelled'?'Отменена':res?.won?'Успех':'Неудача')+'</span></div><p class="muted">'+q.members.map(p=>esc(p.name)).join(' · ')+'</p>'+(active?'<p>До возвращения: <b data-h-timer="'+r.ends_at+'"></b></p><p class="muted">Возвращение: '+esc(date(r.ends_at))+'. Успех '+q.chance+'%. Исход будет раскрыт после завершения.</p>':'<p>Получено: <b>'+number(res?.francs)+' ₣</b>'+(res?.tax?' · налог '+res.tax+' ₣':'')+(res?.pages?' · '+res.pages+' стр. '+esc(rarities[res.page_rarity])+' редкости':'')+'</p><div class="holdings-outcomes">'+(res?.members||[]).map(p=>'<p>'+esc(q.members.find(m=>m.user_id===p.user_id)?.name||p.user_id)+' — '+esc(({returned:'вернулся',freed:'освободился',removed:'владение изменилось — исключён из награды',cancelled:'отмена без потерь'})[p.outcome]||p.outcome)+'</p>').join('')+'</div>')+'</article>'}
  function raidsScreen(){if(mission){const m=data.missions.find(m=>m.id===mission);return '<div class="holdings-section-head"><div><h2>Сбор отряда</h2><p class="muted">'+esc(m.name)+' · '+duration(m.duration)+' · до 5 участников</p></div>'+button('←','back-raids')+'</div><div class="note">Сила — условный рейтинг текущего персонажа арены. Выбор класса, снаряжённые навыки и пассивки фиксируются при отправке. Итоговые шансы увидишь перед подтверждением.</div>'+roster(data.people)+bulk()}const running=data.expeditions.some(r=>r.status==='active')||data.other_expedition_chat;return '<div class="holdings-section-head"><div><h2>Экспедиции</h2><p class="muted">Один отряд на владельца во всех чатах</p></div></div>'+(!data.arena_enabled?'<div class="note">Для новых экспедиций нужно включить арену в этом чате.</div>':'')+(data.other_expedition_chat?'<div class="note">Твой отряд уже в другом чате. Дождись возвращения.</div>':'')+data.expeditions.filter(r=>r.status==='active').map(expeditionCard).join('')+data.missions.map(m=>'<article class="holdings-site"><div class="holdings-section-head"><h3>'+esc(m.name)+'</h3><span class="pill">'+duration(m.duration)+'</span></div><p class="muted">Рекомендуемый уровень: '+esc(m.recommended)+'. Отряд 1–5 участников.</p><p>До '+number(m.francs*5)+' ₣ до налога · '+m.pages+' стр. '+esc(rarities[m.page_rarity])+' редкости</p>'+button('Собрать отряд','mission:'+m.id,true,Boolean(running)||!data.arena_enabled||!data.people.length)+'</article>').join('')+'<details class="holdings-settings"><summary>Правила и награды</summary><p class="muted">Слабые участники сильнее рискуют на сложных заданиях. Успех похода и возвращение каждого рассчитываются отдельно. Потерянный раб освобождается: уровень, вещи и персонаж не теряются. Работники не приносят доход во время отсутствия, но сохраняют рабочие места. Владелец получает добычу пропорционально вернувшимся; страницы — при успешном возвращении хотя бы одного. Участники получают личную выплату в пределах прежнего недельного лимита труда. Один участник может отправляться раз в 6 часов, ограничение общее для всех владельцев и чатов. Сами игроки могут продолжать бои на арене.</p></details>'+ (data.expeditions.some(r=>r.status!=='active')?'<h3>Последние походы</h3>'+data.expeditions.filter(r=>r.status!=='active').map(expeditionCard).join(''):'')}
  function render(){if(!data)return;const y=window.scrollY;app.innerHTML='<section class="menu holdings"><header class="top"><div><div class="eyebrow">ГНИДА · ВЛАДЕНИЯ'+(demo?' · ДЕМО':'')+'</div><h1>Твоя империя</h1></div><div class="holdings-top-actions">'+button('Арена','arena',false,!data.arena_enabled)+button('↻','refresh')+'</div></header><div class="content"><div class="holdings-context"><label>Чат<select id="holdings-chat" aria-label="Выбранный чат">'+chats.map(c=>'<option value="'+c.chat_id+'"'+(c.chat_id===data.chat_id?' selected':'')+'>'+esc(c.title)+'</option>').join('')+'</select></label><div><small>Кошелёк чата</small><strong>'+number(data.balance)+' ₣</strong></div></div><nav class="holdings-tabs" aria-label="Разделы владений">'+[['overview','Обзор'],['people','Рабы · '+data.people.length],['sites','Предприятия'],['raids','Экспедиции']].map(([v,n])=>'<button type="button" data-h="tab:'+v+'" aria-pressed="'+(tab===v)+'">'+esc(n)+'</button>').join('')+'</nav><div id="holdings-notice" role="status" aria-live="polite" hidden></div><div id="holdings-screen">'+(tab==='overview'?overview():tab==='people'?'<div class="holdings-section-head"><div><h2>Твои рабы</h2><p class="muted">'+(pickerSite?'Добавление в «'+esc(site(pickerSite)?.title)+'»':'Массовое назначение и перевод работников')+'</p></div></div>'+roster(data.people.filter(available))+bulk():tab==='sites'?sitesScreen():raidsScreen())+'</div><footer class="holdings-footer">Владения и франки — в выбранном чате. Персонажи и страницы — общие.</footer></div></section>';window.scrollTo({top:y,behavior:'instant'});updateTimers()}
  function modal(title,body,confirm){
    closeModal();const opened=document.createElement('dialog');dialog=opened;
    opened.className='holdings-dialog';opened.innerHTML='<div class="holdings-section-head"><h2>'+esc(title)+'</h2><button type="button" data-h="cancel" aria-label="Закрыть">×</button></div>'+body+'<div class="holdings-buttons">'+button('Отмена','cancel')+(confirm?button(confirm.label,confirm.action,true):'')+'</div>';
    opened.addEventListener('click',handleClick);
    opened.addEventListener('change',()=>{if(opened===dialog&&opened.querySelector('#holdings-destination'))assignmentCheck()});
    opened.addEventListener('close',()=>{opened.remove();if(dialog===opened){dialog=null;quote=null}});
    document.body.append(opened);opened.showModal();
  }
  function closeModal(){if(dialog){const d=dialog;dialog=null;d.close();d.remove()}quote=null}
  async function load(chatId,initial=false){const generation=++requestGeneration;pending=true;try{const next=demo?demoData(chatId):await api('/api/holdings/'+chatId);if(generation!==requestGeneration)return;data=next;offset=data.server_time*1000-Date.now();render();if(initial)window.scrollTo(0,0)}catch(e){if(initial&&!data)app.innerHTML='<div class="loading"><h2>Не удалось открыть владения</h2><p>'+esc(e.message)+'</p>'+button('Выбрать другой чат','choose-chat')+'</div>';else notice(e.message,true)}finally{if(generation===requestGeneration)pending=false}}
  async function mutate(body){if(pending)return;pending=true;const chat=data.chat_id;dialog?.querySelectorAll('button').forEach(b=>b.disabled=true);try{const response=demo?demoAction(body):await api('/api/holdings/'+chat,body);closeModal();selected.clear();data=response.holdings;offset=data.server_time*1000-Date.now();render();notice(response.notice);return true}catch(e){closeModal();notice(e.message,true);return false}finally{pending=false}}
  function assignment(){if(!selected.size)return;const options=data.sites.map(s=>'<option value="'+s.id+'"'+(s.id===(pickerSite||siteId)?' selected':'')+'>'+esc(s.title)+' · '+s.workers.length+'/'+s.capacity+'</option>').join('');modal('Назначение работников','<p>Выбрано: '+selected.size+'. При переводе прежнее назначение снимается.</p><label>Предприятие<select id="holdings-destination">'+options+'</select></label><label>Должность<select id="holdings-role"><option value="worker">Работник</option><option value="leader">Управляющий</option></select></label><p id="holdings-assignment-check" class="note"></p>',{label:'Подтвердить',action:'confirm-assign'});assignmentCheck()}
  function assignmentCheck(){const s=site(dialog.querySelector('#holdings-destination').value),r=dialog.querySelector('#holdings-role').value,others=s.workers.filter(w=>!selected.has(w.worker_id));const invalid=others.length+selected.size>s.capacity?'Недостаточно мест. Выбери другое предприятие или уменьши отряд.':r==='leader'&&(selected.size!==1||others.some(w=>w.role===role(s,true)))?'Нужен один участник и свободная должность управляющего.':null;dialog.querySelector('#holdings-assignment-check').textContent=invalid||'После назначения: '+(others.length+selected.size)+'/'+s.capacity+'.';dialog.querySelector('[data-h="confirm-assign"]').disabled=Boolean(invalid)}
  async function getQuote(){if(pending)return;pending=true;try{const result=demo?{quote:demoQuote()}:await api('/api/holdings/'+data.chat_id,{action:'expedition_quote',mission,users:[...selected]});const q=result.quote;modal('Отправить отряд?','<h3>'+esc(q.name)+' · '+duration(q.duration)+'</h3><p>Шанс успеха: <b>'+q.chance+'%</b></p>'+q.members.map(p=>'<div class="holdings-quote-person"><img src="'+esc(image(p))+'" alt=""><span><b>'+esc(p.name)+'</b><small>Сила '+p.power+' · ур. '+p.level+'</small></span><span>Риск освобождения<br><b>'+p.loss_win+'% / '+p.loss_fail+'%</b><small>успех / провал</small></span></div>').join('')+'<p class="muted">'+q.bonuses.map(esc).join(' · ')+'</p><div class="note">При успехе: до '+q.owner_francs+' ₣ до налога и '+q.pages+' стр. '+esc(rarities[q.page_rarity])+' редкости. Владельцу — доля за вернувшихся. Каждому вернувшемуся: до '+q.participant_francs+' ₣ в пределах лимита труда. При потере участник освобождается.</div><p class="muted">Работники сохранят места, но не будут получать зарплату и приносить доход во время похода. Риски не меняются после отправки.</p>',{label:'Отправить на '+duration(q.duration),action:'confirm-expedition'});quote={...q,nonce:nonce()}}catch(e){notice(e.message,true)}finally{pending=false}}
  async function handleClick(event){const b=event.target.closest('[data-h]');if(!b||b.disabled)return;const [cmd,...parts]=b.dataset.h.split(':'),arg=parts.join(':');if(cmd==='cancel'){closeModal();return}if(pending)return;
    if(cmd==='tab'){tab=arg;siteId=null;pickerSite=null;mission=null;selected.clear();search='';filter='all';page=0;render();return}
    if(cmd==='refresh'){await load(data.chat_id);return}if(cmd==='choose-chat'){await open({app,api,onArena,demo});return}
    if(cmd==='arena'){stop();onArena(data.chat_id);return}
    if(cmd==='site'){tab='sites';siteId=Number(arg);selected.clear();page=0;filter='all';search='';render();return}
    if(cmd==='back-sites'){siteId=null;selected.clear();render();return}
    if(cmd==='fill'){tab='people';pickerSite=Number(arg);siteId=null;filter='free';search='';page=0;selected.clear();render();return}
    if(cmd==='free-workers'){tab='people';pickerSite=null;filter='free';page=0;selected.clear();render();return}
    if(cmd==='raids'){tab='raids';mission=null;selected.clear();render();return}
    if(cmd==='mission'){tab='raids';mission=arg;selected.clear();filter='all';search='';page=0;render();return}
    if(cmd==='back-raids'){mission=null;selected.clear();render();return}
    if(cmd==='prev'||cmd==='next'){page+=cmd==='prev'?-1:1;render();return}
    if(cmd==='clear'){selected.clear();render();return}
    if(cmd==='select-page'){for(const checkbox of app.querySelectorAll('[data-h-person]:not(:disabled)')){if(mission&&selected.size>=5)break;selected.add(Number(checkbox.dataset.hPerson))}render();return}
    if(cmd==='auto'){const s=site(arg);selected=new Set(data.people.filter(free).slice(0,Math.max(0,s.capacity-s.workers.length)).map(p=>p.user_id));pickerSite=s.id;assignment();return}
    if(cmd==='assign'){if(!data.sites.length){notice('Сначала открой предприятие.',true);return}assignment();return}
    if(cmd==='confirm-assign'){await mutate({action:'assign',users:[...selected],site:Number(dialog.querySelector('#holdings-destination').value),role:dialog.querySelector('#holdings-role').value,revision:data.revision});return}
    if(cmd==='remove'){modal('Снять с работ?','<p>Выбрано: '+selected.size+'. Они останутся твоими рабами. Назначения на предприятиях будут удалены.</p>',{label:'Снять с работ',action:'confirm-remove'});return}
