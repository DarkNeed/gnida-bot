function raidNewEvents(previous,next){
  if(!previous?.data||previous.token!==next.token)return [];
  const last=Math.max(0,...previous.data.log.map(e=>Number(e.seq)||0));
  // Legacy records have no visual snapshots. Opening/reloading never replays history.
  const events=(next.data?.log||[]).filter(e=>e.seq>last&&e.after);
  // Long offline gaps jump to the authoritative state instead of playing a backlog.
  return events.length<=16&&(!last||!events.length||events[0].seq===last+1)?events:[];
}
function raidVisual(data,snapshot){
  const view=JSON.parse(JSON.stringify(data));
  for(const [key,values] of Object.entries(snapshot||{})){
    const f=key==='boss'?view.data.boss:view.data.players[key]?.fighter;
    if(f)Object.assign(f,values);
  }
  return view;
}
