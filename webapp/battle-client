async function api(path,body){
  const response=await fetch(path,{method:body?"POST":"GET",headers:{"Content-Type":"application/json","X-Telegram-Init-Data":tg?.initData||""},body:body?JSON.stringify(body):undefined,cache:"no-store"});
  const data=await response.json();
  if(!response.ok)throw new Error(data.error||"Сервер недоступен.");
  if(Number.isFinite(data.server_time))serverClockOffset=data.server_time*1000-Date.now();
  return data;
}
