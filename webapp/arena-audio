"use strict";
// Original procedural soundtrack/SFX. Browser-only, extensionless for BotHost.
(() => {
  const KEY = 'gnida.arena.audio.v1';
  const THEMES = {
    menu: {bpm: 78, roots: [45, 41, 48, 43], motif: [0, 7, 10, 14, 10, 7, 3, 7], soft: true},
    battle: {bpm: 112, roots: [45, 45, 41, 43], motif: [0, 12, 7, 10, 0, 7, 3, 10]},
    raid: {bpm: 100, roots: [38, 41, 36, 37], motif: [0, 7, 12, 10, 7, 3, 10, 7]},
    lei_heng: {bpm: 124, roots: [40, 40, 43, 38], motif: [0, 7, 12, 15, 12, 7, 5, 7]},
    doofenshmirtz: {bpm: 116, roots: [42, 45, 40, 41], motif: [0, 12, 3, 11, 7, 3, 12, 6]}
  };
  let prefs = {muted: true, music: 22, effects: 50};
  try {
    const p = JSON.parse(localStorage.getItem(KEY));
    if(p && typeof p === 'object') {
      if(typeof p.muted === 'boolean') prefs.muted = p.muted;
      for(const k of ['music','effects']) if(Number.isFinite(p[k])) prefs[k] = Math.max(0,Math.min(100,p[k]));
    }
