    if(side.mirror_gift_details?.length)panel.innerHTML+='<details><summary>Дары зеркала · '+side.mirror_gift_details.length+'</summary>'+side.mirror_gift_details.map(g=>'<p class="muted"><b>'+esc(g.name)+'</b> · '+esc(g.description)+'</p>').join('')+'</details>';
