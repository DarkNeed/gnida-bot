async function poll(){
  if(raidCurrent){await pollRaid();return;}
  if(polling||busy||!token||demo||document.hidden||current?.status!=="active"&&current?.status!=="pending")return;
  polling=true;
  try{
    const data=await api("/api/battle/"+token);
    if(!busy&&token===data.token&&(!current||data.revision>current.revision)){busy=true;try{await applyBattle(data);}finally{busy=false;}}
  }catch(error){toast(error.message);}finally{polling=false;}
}
