function raidPhaseSprite(data){
  const path=data.boss_sprites?.[String(data.data?.phase)];
  if(data.data?.boss&&/^\/static\/assets\/[a-z_]+\.png$/.test(path||''))data.data.boss.class_avatar_url=path;
}
function raidSoundtrack(data){
  if(data.status!=='active')return data.status==='lobby'?'menu':'';
  if(data.boss_id==='chaplain'){
    const phase=Number(data.data?.phase||1);
    return phase>=4?'chaplain_root':phase>=3?'chaplain_override':phase>=2?'chaplain_fault':'chaplain';
  }
  if(data.boss_id==='kit'){
    const phase=Number(data.data?.phase||1);
    return phase>=3?'kit_abyss':phase>=2?'kit_menace':'raid';
  }
  return data.boss_id==='doofenshmirtz'?'doofenshmirtz':data.boss_id==='lei_heng'?'lei_heng':'raid';
}
function raidPortrait(f,key,player=null,index=0,spriteTarget=null){
  const disabled=player?.withdrawn||f.hp<=0;
  const effects=fighterStatuses(f).map(e=>'<span class="raid-effect" title="'+esc(e.name)+'">'+statusIcon(e.icon,e.direction)+'<span class="status-count">'+esc(e.count)+'</span></span>').join('');
  const own=key===String(raidCurrent.actor_id),boss=key==='boss'||!!raidCurrent.data?.enemies?.[key];
  const art=spriteTarget?'<button type="button" class="raid-art encounter-target" data-raid="target:'+esc(key)+'" aria-label="Выбрать цель: '+esc(f.name)+'" aria-pressed="'+(key===encounterTarget)+'"'+(disabled?' disabled':'')+'>':'<div class="raid-art">';
  return '<article id="raid-fighter-'+esc(key)+'" class="raid-fighter '+(boss?'raid-enemy':'raid-ally slot-'+index)+(own?' raid-own':'')+(disabled?' defeated':'')+(player?.deported_round===raidCurrent.data.round?' raid-deported':'')+'">'+art+fighterImage(chaplainArt(f,key),'raid-sprite')+'<div class="raid-ground"></div>'+(spriteTarget?'</button>':'</div>')+'<div class="raid-effects">'+effects+'</div><div class="raid-hud"><div class="row"><strong title="'+esc(f.name)+'">'+esc(f.name)+'</strong>'+raidButton('ⓘ','inspect:'+key,'stat-button')+'</div><div class="muted">'+esc(f.class_name)+' · Lv.'+f.level+'</div>'+raidBar(f.hp,f.stats.max_hp,'HP')+(boss&&raidCurrent.boss_id!=='doofenshmirtz'?'':raidBar(f.resource,f.stats.resource_max,f.resource_name,'mana'))+(player?'<div class="raid-ready">'+(player.withdrawn?'Покинул рейд':f.hp<=0?'Боец повержен':player.deported_round===raidCurrent.data.round?'Вернётся в следующем раунде':player.ready?'✓ Готов':own?'Твой боец':'Выбирает навык')+'</div>':'')+'</div></article>';
