function closeEffect(){
  const selected=inspectEffect,dialog=document.getElementById('battle-effect');
  if(dialog?.tagName==='DIALOG'){dialog.close();dialog.remove();}
  inspectEffect=null;
  if(selected)for(const b of app.querySelectorAll?.('[data-status-id]')||[])if(b.dataset.statusSide===selected.side&&b.dataset.statusId===selected.id){b.focus({preventScroll:true});break;}
}
function showEffect(key,id){
  const side=statusSide(key),item=side&&fighterStatuses(side).find(e=>e.id===id);
  if(!item){closeEffect();return;}
  if(inspectSide)closeStats();
  inspectEffect={side:key,id};
  let dialog=document.getElementById('battle-effect');const fresh=!dialog;
  if(fresh){
    dialog=document.createElement('dialog');dialog.id='battle-effect';dialog.className='effect-dialog';dialog.setAttribute('aria-label','Описание эффекта');
    dialog.addEventListener('cancel',e=>{e.preventDefault();closeEffect();});
    dialog.addEventListener('click',e=>{const r=dialog.getBoundingClientRect();if(e.target.closest('[data-close-effect]')||(e.target===dialog&&(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)))closeEffect();});document.body.append(dialog);
