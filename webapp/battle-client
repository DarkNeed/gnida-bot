  if(!dialog.open)dialog.showModal();
}
async function raidAction(action,extra={}){
  if(busy||raidPlaying||!raidCurrent)return;
  if(demo){toast('Демо рейда: действия не сохраняются.');return;}
  busy=true;
  const captured=raidCurrent.token;
  try{const data=await api('/api/raid/'+captured,{action,...extra});if(raidCurrent?.token===captured)await receiveRaid(data);}
  catch(error){toast(error.message);try{raidScreen(await api('/api/raid/'+raidCurrent.token));}catch{}}
  finally{busy=false;}
}
async function pollRaid(){
  if(polling||busy||raidPlaying||demo||document.hidden||!raidCurrent||!['lobby','active'].includes(raidCurrent.status))return;
  const captured=raidCurrent.token;polling=true;
  try{const data=await api('/api/raid/'+captured);if(!busy&&!raidPlaying&&raidCurrent?.token===captured&&data.revision>raidCurrent.revision)await receiveRaid(data);}
  catch(error){toast(error.message);}finally{polling=false;}
}
