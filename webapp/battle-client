function encounterCanTarget(data=raidCurrent){
  const own=data?.data?.players?.[String(data.actor_id)];
  return !!(data?.kind==='encounter'&&data.status==='active'&&!raidPlaying&&!data.qte?.waiting&&own&&!own.withdrawn&&own.fighter.hp>0&&!own.ready);
}
function encounterPortrait(f,key,index){
  return raidPortrait(f,key,null,index,encounterCanTarget()).replace('raid-enemy','raid-enemy encounter-enemy enemy-'+index+(key===encounterTarget?' encounter-selected':''));
}
function selectEncounterTarget(key){
  if(!encounterCanTarget()||!raidCurrent.data.enemies[key]||raidCurrent.data.enemies[key].hp<=0)return;
  encounterTarget=key;
  for(const article of app.querySelectorAll('.encounter-enemy')){
    const selected=article.id==='raid-fighter-'+key;
    article.classList.toggle('encounter-selected',selected);
    article.querySelector('.encounter-target')?.setAttribute('aria-pressed',String(selected));
  }
  const label=document.getElementById('encounter-target-name');
  if(label)label.textContent=raidCurrent.data.enemies[key].name;
