      function text(value,x,y,color='#a3b8ce',size=13,align='left'){
        ctx.font=`500 ${Math.max(size,Math.min(22,7200/Math.max(1,canvas.clientWidth)))}px Segoe UI, sans-serif`;
        ctx.fillStyle=color;ctx.textAlign=align;ctx.fillText(value,x,y);
      }
      function draw(){
        ctx.clearRect(0,0,720,320);ctx.fillStyle='#080f19';ctx.fillRect(0,0,720,320);ctx.strokeStyle='#172536';ctx.lineWidth=1;
        for(let x=20;x<720;x+=40){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,320);ctx.stroke();}
        for(let y=20;y<320;y+=40){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(720,y);ctx.stroke();}
        if(!defense){
          const f=E.attackFrame(sim),left=55,width=610,y=130;
          text(`ОТМЕТКА ${f.index+1} / ${n}`,55,48);text('НАЖМИ В ЗОЛОТОЙ ЗОНЕ',665,48,'#e6b963',13,'right');
          ctx.fillStyle='#1b2d44';ctx.fillRect(left,y,width,50);
          const zx=left+(f.center-f.width/2)*width;ctx.fillStyle='#e6b96344';ctx.fillRect(zx,y,f.width*width,50);
          ctx.strokeStyle='#e6b963';ctx.strokeRect(zx,y,f.width*width,50);
          ctx.fillStyle='#ecf6ff';ctx.fillRect(left+f.cursor*width-2,y-10,4,70);
          sim.results.forEach((result,i)=>{ctx.beginPath();ctx.arc(360-(n-1)*18+i*36,240,9,0,Math.PI*2);ctx.fillStyle=result===true?'#80d5b4':result===false?'#ef8883':'#344b65';ctx.fill();});
        }else{
          for(const w of sim.waves){
            if(sim.time<w.at||w.spawned)continue;
            ctx.setLineDash([8,8]);ctx.strokeStyle=w.curtain?'#80d5b480':'#e6b96380';ctx.fillStyle='#80d5b409';
            const vertical=sim.id==='rain',c=w.lane*(vertical?720:320);
            const half=w.curtain?Math.max(8,sim.p.gap/2-sim.p.radius-sim.player.r):0;
            if(vertical){
              ctx.fillRect(c-half,0,half*2,320);
              for(const x of half?[c-half,c+half]:[c]){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,320);ctx.stroke();}
              text(w.reverse?'▲':'▼',c,w.reverse?298:24,'#80d5b4',18,'center');
            }else{
              ctx.fillRect(0,c-half,720,half*2);
              for(const y of half?[c-half,c+half]:[c]){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(720,y);ctx.stroke();}
              text(w.reverse?'▶':'◀',w.reverse?20:700,c+6,w.curtain?'#80d5b4':'#e6b963',18,'center');
              if(sim.id==='cross'){const x=(w.crossLane??w.lane)*720;ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,320);ctx.stroke();text('▼',x,24,'#e6b963',18,'center');}
            }
          }
          ctx.setLineDash([]);
          for(const b of sim.bullets){ctx.save();ctx.translate(b.x,b.y);ctx.rotate(Math.atan2(b.vy,b.vx));ctx.fillStyle=sim.received.includes(b.strike)?'#78575c':'#efc397';ctx.beginPath();ctx.moveTo(13,0);ctx.lineTo(-8,-b.r);ctx.lineTo(-3,0);ctx.lineTo(-8,b.r);ctx.closePath();ctx.fill();ctx.restore();}
          ctx.save();ctx.translate(sim.player.x,sim.player.y);ctx.rotate(Math.PI/4);ctx.fillStyle='#80d5b4';ctx.shadowColor='#80d5b4';ctx.shadowBlur=15;ctx.fillRect(-6,-6,12,12);ctx.restore();
          text('КАСАНИЯ: '+sim.received.length,700,302,sim.received.length?'#ef8883':'#80d5b4',12,'right');
        }
      }
      function frame(now){
        if(done)return;
        const dt=last?(now-last)/1000:0;last=now;
        if(now>=deadline){finish(true);return;}
        accumulator+=dt;
        while(accumulator>=1/120&&!done){accumulator-=1/120;step();}
        if(done)return;draw();
        find('.qte-count').textContent=Math.max(0,sim.duration-sim.time).toFixed(1)+' С';
        raf=requestAnimationFrame(frame);
      }
      watch=setInterval(()=>{if(performance.now()>=deadline)finish(true);},200);
      draw();raf=requestAnimationFrame(frame);
    });
  }
})();
