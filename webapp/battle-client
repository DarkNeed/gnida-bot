}
function chaplainPanel(data,own){
  const m=data.data?.chaplain;if(data.boss_id!=='chaplain'||!m)return '';
  const names={damage:'урон боссу',healing:'лечение отряда',cleanse:'очищение отряда'};
  const anchors=Object.entries(m.anchors||{}).map(([key,a])=>esc(data.data.players[key]?.fighter.name)+': '+names[a.kind]+' до конца раунда '+a.until);
  const marked=m.banned?.[String(data.actor_id)],skill=own?.fighter.skill_details.find(s=>s.skill_id===marked);
  const rolling=data.data.intent.kind==='chaplain_rewind';
  return '<div class="card chaplain-regulation'+(rolling?' sealed':'')+'"><b>◷ '+(rolling?'Объявлен откат раунда':'Регламент времени')+'</b><p>'+(rolling?'Вместо атаки Капеллан перепишет предыдущий раунд. Закрепление сохранит выбранный результат.':'Обычный откат — отдельное действие раз в 5–7 раундов. Закрепление действует три раунда. Фазовое восстановление возвращает только HP босса.')+'</p>'+(skill?'<p class="chaplain-marked">Помечен «'+esc(skill.name)+'»: дополнительная цена 10% максимального HP, не смертельно.</p>':'')+(m.ui_scramble?'<p class="muted">Названия повреждены. Удерживай навык, чтобы прочитать карточку без применения.</p>':'')+(anchors.length?'<small>'+anchors.join('<br>')+'</small>':'')+'</div>';
}
function chaplainSkills(data,f){
  const m=data.data.chaplain,order=m?.ui_order?.[String(data.actor_id)]||[];
  const list=[...f.skill_details];if(data.boss_id==='chaplain'&&order.length)list.sort((a,b)=>{const ai=order.indexOf(a.skill_id),bi=order.indexOf(b.skill_id);return (ai<0?999:ai)-(bi<0?999:bi);});
  const render=s=>{
    const hidden=data.boss_id==='chaplain'&&m.ui_scramble;
    const label='<span class="skill-type">'+(s.damage_type==='physical'?'АТАКА':s.damage_type==='magic'?'МАГИЯ':'ЭФФЕКТ')+'</span><strong>'+(hidden?'<span aria-hidden="true">ДОСТУП ▓▒░</span><span class="chaplain-real-name">'+esc(s.name)+'</span>':esc(s.name))+'</strong><small>'+s.cost+' '+esc(f.resource_name)+(f.cooldowns[s.skill_id]?' · ещё '+f.cooldowns[s.skill_id]+' х.':'')+(s.unavailable_reason?' · '+esc(s.unavailable_reason):'')+'</small>';
    return raidButton(label,'skill:'+s.skill_id,'skill'+(s.evolution?.active?' evolved':'')+(hidden?' chaplain-obscured':''),s.cost>f.resource||!!f.cooldowns[s.skill_id]||!!s.unavailable_reason);
  };
  if(f.rp_sandbox&&list.length>8){
    return [['physical','Физические атаки'],['magic','Магические атаки'],[null,'Поддержка и эффекты']].map(([kind,title])=>{
      const selected=list.filter(s=>(s.damage_type||null)===kind);
      return selected.length?'<details class="rp-battle-skills"><summary>'+title+' · '+selected.length+'</summary><div class="raid-skillgrid">'+selected.map(render).join('')+'</div></details>':'';
    }).join('');
  }
  return list.map(render).join('');
}
function chaplainArt(f,key){
  const d=raidCurrent?.data,swap=d?.chaplain?.swap_target;
  if(raidCurrent?.boss_id!=='chaplain'||d.phase<3||!swap||key!=='boss'&&key!==swap)return f;
  const other=key==='boss'?d.players[swap]?.fighter:d.boss;if(!other)return f;
  return {...f,class_avatar_url:other.class_avatar_url,sprite_url:other.sprite_url,pixel_art:other.pixel_art};
}
function raidPhaseLabel(data){
  if(data.kind==='encounter')return 'РП-ВСТРЕЧА · РАУНД '+data.data.round;
  const d=data.data;return (data.boss_id==='chaplain'&&d.phase<3?'РЕГЛАМЕНТ':('ФАЗА '+d.phase+' / '+(data.phase_count||d.phase_count||2)))+' · РАУНД '+d.round;
}
function showChaplainSkill(id){
  const s=raidCurrent?.data?.players[String(raidCurrent.actor_id)]?.fighter.skill_details.find(s=>s.skill_id===id);if(!s)return;
  document.getElementById('chaplain-skill-card')?.remove();const dialog=document.createElement('dialog');dialog.id='chaplain-skill-card';dialog.className='stats-dialog';
  dialog.innerHTML='<div class="stats-header"><b>'+esc(s.name)+'</b><button class="small">Закрыть ×</button></div><p>'+esc(s.description||'')+'</p><p>Стоимость: '+s.cost+' · перезарядка: '+s.cooldown+'</p>';
  dialog.querySelector('button').onclick=()=>{dialog.close();dialog.remove();};dialog.addEventListener('cancel',()=>dialog.remove());document.body.append(dialog);dialog.showModal();
}
let chaplainHold=null;
app.addEventListener('pointerdown',e=>{const b=e.target.closest('.chaplain-obscured');if(!b)return;clearTimeout(chaplainHold);chaplainHold=setTimeout(()=>{b.dataset.chaplainRead='1';showChaplainSkill(b.dataset.raid.slice(6));},420);},true);
for(const type of ['pointerup','pointercancel'])app.addEventListener(type,()=>clearTimeout(chaplainHold),true);
app.addEventListener('pointerleave',()=>clearTimeout(chaplainHold));
app.addEventListener('keydown',e=>{const b=e.target.closest('.chaplain-obscured');if(b&&e.key==='Enter'&&e.shiftKey){e.preventDefault();e.stopImmediatePropagation();showChaplainSkill(b.dataset.raid.slice(6));}},true);
