function configureViewport(){
  tg?.ready();tg?.expand();
  const syncInsets=()=>{
    const root=document.documentElement;
    for(const [prefix,insets] of [['system',tg?.safeAreaInset],['content',tg?.contentSafeAreaInset]]){
      for(const side of ['top','right','bottom','left']){
        const value=insets?.[side],property='--app-'+prefix+'-'+side;
        if(Number.isFinite(value)&&value>=0)root.style.setProperty(property,value+'px');
        else root.style.removeProperty(property);
      }
    }
    // Older clients may report fullscreen before sending their content insets.
    root.style.setProperty('--app-fs-top',tg?.isFullscreen?'44px':'0px');
  };
  syncInsets();
  for(const event of ['safeAreaChanged','contentSafeAreaChanged','fullscreenChanged','viewportChanged'])tg?.onEvent?.(event,syncInsets);
  window.addEventListener('resize',syncInsets);
  try{
    if(tg?.isVersionAtLeast?.("8.0")){
      const mobile=tg.platform==="android"||tg.platform==="ios";
      if(mobile&&!tg.isFullscreen)tg.requestFullscreen?.();
      else if(!mobile&&tg.isFullscreen)tg.exitFullscreen?.();
    }
  }catch{}
  try{tg?.setHeaderColor("#0c1324");tg?.setBackgroundColor("#0c1324");}catch{}
}
async function boot(){
  configureViewport();
  if(demo){
    if(new URLSearchParams(location.search).has('holdings')){await openHoldings(-1);return;}
    if(new URLSearchParams(location.search).has('skills_preview')){startDemoMenu();return;}
    const raidPreview=new URLSearchParams(location.search).get('raid_preview');
    if(raidPreview){try{raidScreen(await api('/demo/raid/'+encodeURIComponent(raidPreview)));return;}catch{}}
    const mirrorPreview=new URLSearchParams(location.search).get('mirror_preview');
    if(mirrorPreview){try{mirrorScreen(await api('/demo/mirror/'+encodeURIComponent(mirrorPreview)));return;}catch{}}
    const cls=new URLSearchParams(location.search).get('fighter');
    if(['cutie','jock','nerd','thumb','index','middle','ring','pinky','warrior','mage','priest','hunter'].includes(cls)){
      const previewParams=new URLSearchParams(location.search);
      try{battleScreen(await api('/demo/fighter/'+cls+'?arch='+encodeURIComponent(previewParams.get('arch')||'')+'&stage='+encodeURIComponent(previewParams.get('stage')||'20')+'&mastery='+encodeURIComponent(previewParams.get('mastery')||'0')));return;}catch{}
    }
    startDemo();return;
  }
  const start=new URLSearchParams(location.search).get("tgWebAppStartParam")||tg?.initDataUnsafe?.start_param||"";
  try{
    if(start==='rp'||/^rp_-?\d+$/.test(start)||location.pathname==='/rp'){await openRP(/^rp_-?\d+$/.test(start)?Number(start.slice(3)):null);return;}
    if(start==='pets'||/^pets_-?\d+$/.test(start)){location.replace('/pets'+(start==='pets'?'':'?chat='+start.slice(5))+location.hash);return;}
    if(start==='holdings'||/^holdings_-?\d+$/.test(start)){await openHoldings(start==='holdings'?null:Number(start.slice(9)));}
    else if(start.startsWith("r_")){raidScreen(await api('/api/raid/'+start.slice(2)));}
    else if(start.startsWith("b_")){token=start.slice(2);const data=await api("/api/battle/"+token);lastSeq=data.state?.log.at(-1)?.seq||0;battleScreen(data);}
    else if(/^(menu|shop)_-?\d+$/.test(start)){chat=Number(start.slice(5));if(start.startsWith('shop_'))page='merchant';await openMenu();}
    else app.innerHTML='<div class="loading"><h2>Открой арену из бота</h2><p class="muted">Кнопка «Арена» в /menu или «Открыть бой» под вызовом в чате.</p></div>';
  }catch(error){app.innerHTML='<div class="loading"><h2>Не удалось открыть арену</h2><p>'+esc(error.message)+'</p></div>';}
}
