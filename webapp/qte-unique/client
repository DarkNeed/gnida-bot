  }
  function drawHazard(h,t,spent=false){
    const warning=t<h.start,g=E.geometry(h,t),major=h.tier==='heavy'||h.tier==='critical',color=major?(h.tier==='critical'?'#fff0b7':'#e8bd7c'):selected.color;
