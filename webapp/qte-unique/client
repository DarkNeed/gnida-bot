  for(const id of ['class-filter','family-filter','search'])$(id).addEventListener(id==='search'?'input':'change',()=>{if(sim)return;record=null;filter();controls();});
  $('skill').addEventListener('change',()=>{if(sim)return;selected=byId.get($('skill').value)||selected;record=null;labels();controls();drawIdle();});
  for(const [id,delta] of [['previous',-1],['next',1]])$(id).addEventListener('click',()=>{if(sim||filtered.length<2)return;selected=filtered[(filtered.indexOf(selected)+delta+filtered.length)%filtered.length];$('skill').value=selected.id;record=null;labels();controls();drawIdle();});
  const presets={equal:[75,25,75,25],strong:[95,75,55,10],weak:[55,5,95,50]};
  document.querySelectorAll('[data-preset]').forEach(b=>b.addEventListener('click',()=>{if(sim)return;presets[b.dataset.preset].forEach((v,i)=>$(statIds[i]).value=v);document.querySelectorAll('[data-preset]').forEach(x=>x.classList.toggle('selected',x===b));labels();}));
  statIds.forEach(id=>$(id).addEventListener('input',()=>{if(!sim){document.querySelectorAll('[data-preset]').forEach(b=>b.classList.remove('selected'));labels();}}));
  for(const id of ['damage-base','test-hp'])$(id).addEventListener('input',()=>{if(!sim){record=null;labels();controls();drawIdle();}});
  const keymap={ArrowLeft:'left',ArrowRight:'right',ArrowUp:'up',ArrowDown:'down',KeyA:'left',KeyD:'right',KeyW:'up',KeyS:'down'};
  window.addEventListener('keydown',e=>{
    if(!sim||paused||/INPUT|SELECT|TEXTAREA/.test(document.activeElement?.tagName||''))return;
    if(e.code==='Escape'){e.preventDefault();finish(true);return;}
    if(e.code==='Space'&&mode==='attack'){e.preventDefault();if(!e.repeat)hit();return;}
    if(mode==='defense'&&keymap[e.code]){e.preventDefault();keys.add(keymap[e.code]);}
  });
  window.addEventListener('keyup',e=>{if(keymap[e.code])keys.delete(keymap[e.code]);});
  window.addEventListener('blur',pause);document.addEventListener('visibilitychange',()=>{if(document.hidden)pause();});
  document.querySelectorAll('[data-move]').forEach(b=>{
    b.addEventListener('pointerdown',e=>{if(!sim||paused)return;e.preventDefault();b.setPointerCapture(e.pointerId);pointers.set(e.pointerId,b.dataset.move);touch.clear();});
    for(const name of ['pointerup','pointercancel','lostpointercapture'])b.addEventListener(name,e=>pointers.delete(e.pointerId));
  });
  function input(){const all=new Set([...keys,...pointers.values()]),x=+all.has('right')-+all.has('left'),y=+all.has('down')-+all.has('up');if(x||y)return {x,y};const cmd=touch.input();return cmd.target?{target:{x:cmd.target[0],y:cmd.target[1]}}:cmd;}
  let accumulator=0;
  function frame(now){
    const delta=lastFrame?(now-lastFrame)/1000:0;lastFrame=now;
    if(sim&&!paused){
      if(delta>.25){pause();accumulator=0;}
      else{
        accumulator+=delta;while(accumulator>=1/120&&sim&&!sim.ended){if(mode==='defense')E.defenseStep(sim,1/120,input());else E.attackStep(sim,1/120);accumulator-=1/120;}
        if(sim){$('phase-time').textContent=Math.max(0,sim.duration-sim.time).toFixed(1)+' с';health(sim);if(mode==='defense')drawDefense(sim);else{drawAttack(sim);dots(sim.results);}if(sim.ended)finish();}
      }
    }else accumulator=0;
    requestAnimationFrame(frame);
  }
  const groups=[...new Map(catalog.map(s=>[s.class_id,s.class_name])).entries()];
  $('class-filter').append(new Option('Все классы и боссы',''),...groups.map(([id,name])=>new Option(name,id)));
  const used=new Set(profiles.map(p=>p.kind));for(const [id,f] of Object.entries(E.FAMILIES))if(used.has(id))$('family-filter').append(new Option(f[0],id));
  const examples=[['tigerslayer_flurry','Тигробой'],['arch_mge_bro','Ракетный прыжок'],['butt_peak','Паровозик'],['clench','Захват'],['meow','Мяу'],['arch_hacker','Взлом'],['red_etude','Краска'],['falling_star','Звёзды'],['mana_shot','Огненный шар'],['arch_mage_archmage','Пустота'],['arch_mage_necromancer','Некромант'],['holy_judgment','Кара'],['deportator_inator','Депортатор'],['kit_eclipse','Затмение']];
  for(const [id,name] of examples){
    const p=profiles.find(p=>name==='Паровозик'?p.skill.name==='Билет в паровозик':name==='Огненный шар'?p.skill.name==='Огненный шар':p.skill.base_id===id);
    if(!p)continue;const b=document.createElement('button');b.dataset.example=p.skill.base_id;b.textContent=name;b.addEventListener('click',()=>pick(p));$('examples').append(b);
  }
  $('catalog-count').textContent=profiles.length+' профилей · '+used.size+' механик · отдельно от боёв';
  const query=new URLSearchParams(location.search).get('skill'),deep=profiles.find(p=>p.id===query||p.skill.base_id===query||p.skill.name===query);if(deep)selected=deep;
  filter();labels();controls();drawIdle();requestAnimationFrame(frame);
})();
