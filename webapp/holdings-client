"use strict";
/* Separate controller: ownership is chat-local and never uses arena profile APIs. */
window.HoldingsApp=(()=>{
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const number=v=>Number(v||0).toLocaleString('ru-RU');
  const duration=s=>s<3600?Math.round(s/60)+' мин':s/3600+' ч';
  const date=s=>new Date(s*1000).toLocaleString('ru-RU');
  const rarities={common:'обычной',uncommon:'необычной',rare:'редкой'};
  let app,api,onArena,demo=false,data=null,chats=[],tab='sites',siteId=null,selected=new Set(),filter='all',search='',page=0,
      mission=null,quote=null,pending=false,timer=null,offset=0,pickerSite=null,refreshAt=0,dialog=null,requestGeneration=0;
  function active(){return Boolean(app?.querySelector('.holdings'))}
  function stamp(){return Math.floor((Date.now()+offset)/1000)}
  function nonce(){const b=new Uint8Array(16);crypto.getRandomValues(b);return Array.from(b,x=>x.toString(16).padStart(2,'0')).join('')}
  function image(p){const u=p.avatar_url||'/static/assets/ragamuffin.png';return /^\/(sprites\/[0-9a-f]{64}\.png|static\/assets\/[a-z_/]+\.png)$/.test(u)?u:'/static/assets/ragamuffin.png'}
  function button(label,action,primary=false,disabled=false){return '<button type="button" data-h="'+action+'"'+(primary?' class="primary"':'')+(disabled?' disabled':'')+'>'+label+'</button>'}
  function notice(text,error=false){const n=app.querySelector('#holdings-notice');if(n){n.textContent=text;n.hidden=false;n.classList.toggle('holdings-error',error)}}
  function free(p){return !p.business_id&&!p.away&&!p.expedition_active}
  function unavailable(p){return p.away||p.expedition_active||mission&&(p.listed||p.expedition_ready_at>stamp())}
  function site(id){return data?.sites.find(s=>s.id===Number(id))}
  function available(p){return !unavailable(p)&&(!pickerSite||p.business_id!==pickerSite)}
  function identityBadge(i){if(!i)return '';if(i.appraised===false||!i.rarity)return '<span class="holdings-rarity rarity-unknown">? Редкость неизвестна</span>';const rarity=['common','uncommon','rare','epic','legendary'].includes(i.rarity)?i.rarity:'common';return '<span class="holdings-rarity rarity-'+rarity+'">'+esc(i.rarity_name)+'</span>'}
  function identityDetails(i){if(!i)return '<p class="muted">В старой оценке ещё нет паспорта. Обнови оценку, чтобы увидеть актуальные показатели.</p>';const hidden=i.appraised===false||!i.rarity;return '<div class="holdings-passport">'+identityBadge(i)+'<h3>'+esc(i.trait_name)+'</h3><p class="holdings-trait-flavor">«'+esc(i.trait_flavor)+'»</p><p>'+esc(i.trait_effect)+'</p>'+(hidden?'<div class="note">Редкость скрыта. Оценка у работорговца за 50 ₣ раскроет её и бонусы. Открытие этого окна бесплатно и ничего не списывает.</div>':'<p class="muted">Редкость: +'+i.income_bonus+'% к активной выработке, +'+i.expedition_bonus+'% к силе экспедиции. Бонусы редкости и особенности к выработке складываются. Неактивная выработка и зарплата не увеличиваются.</p>')+'<p><b>Редкость выдана один раз и навсегда.</b> Активность не повышает и не понижает её.</p><p class="muted">Продажа, освобождение, повторный захват и оценка не меняют редкость или особенность. Оценка привязана к текущему владельцу в этом чате. На боевые характеристики арены не влияет.</p></div>'}
  function siteCard(s){const count=s.workers.length,away=s.workers.filter(w=>w.away).length;return '<article class="holdings-site"><div class="holdings-site-top"><div><span class="holdings-kind">'+esc(s.emoji)+' '+esc(s.type_name)+'</span><h2>'+esc(s.title)+'</h2></div><span class="pill">Ур. '+s.level+'</span></div><div class="holdings-meter-label"><span>Работники <b>'+count+' / '+s.capacity+'</b>'+(away?' · отсутствуют '+away:'')+'</span><span>Мест: '+Math.max(0,s.capacity-count)+'</span></div><div class="holdings-meter"><span style="width:'+Math.min(100,count/s.capacity*100)+'%"></span></div><div class="holdings-buttons">'+button('Управлять','site:'+s.id)+button('Добавить работников','fill:'+s.id,true,count>=s.capacity)+'</div></article>'}
  function summary(){const working=data.people.filter(p=>p.business_id&&!p.away).length;return '<div class="holdings-summary"><div><small>Всего рабов</small><strong>'+data.people.length+'</strong></div><div><small>На работе</small><strong>'+working+'</strong></div><div><small>Без работы</small><strong>'+data.people.filter(free).length+'</strong></div></div>'}
  function personRow(p,staff=false){const work=site(p.business_id),blocked=unavailable(p),cooldown=p.expedition_ready_at>stamp(),job=p.expedition_active?'В экспедиции':p.away?'Пропал':p.listed&&mission?'На продаже':staff?(work&&p.role===role(work,true)?work.leader_label:work?.producer_label||'Работник'):work?.title||'Без работы';return '<div class="holdings-person-card"><label class="holdings-person"><input type="checkbox" data-h-person="'+p.user_id+'" aria-label="Выбрать '+esc(p.name)+'"'+(selected.has(p.user_id)?' checked':'')+(blocked?' disabled':'')+'><img src="'+esc(image(p))+'" alt="" loading="lazy"><span class="holdings-person-info"><b>'+esc(p.name)+'</b>'+identityBadge(p.identity)+'<small>'+esc(p.class_name)+' · ур. '+p.level+' · сила '+p.power+'</small>'+(p.identity?'<small>'+esc(p.identity.trait_name)+'</small>':'')+(mission&&cooldown?'<small>Следующий поход: '+esc(date(p.expedition_ready_at))+'</small>':'')+'</span><span class="holdings-job'+(free(p)?' free':'')+'">'+esc(job)+'</span></label>'+(p.identity?button('Особенность и редкость','passport:'+p.user_id):'')+'</div>'}
  function role(s,leader){return s.business_type==='brothel'?(leader?'manager':'courtesan'):s.business_type==='field'?(leader?'overseer':'collector'):(leader?'leader':'worker')}
  function roster(people,staff=false){const rows=people.filter(p=>(!search||(p.name+' '+(p.username||'')).toLowerCase().includes(search.toLowerCase()))&&(filter==='all'||filter==='free'&&free(p)||filter==='working'&&p.business_id&&!p.away||filter==='away'&&(p.away||p.expedition_active)));if(mission)rows.sort((a,b)=>b.power-a.power||a.user_id-b.user_id);page=Math.min(page,Math.max(0,Math.ceil(rows.length/10)-1));return '<div class="holdings-toolbar"><input id="holdings-search" type="search" placeholder="Имя или @тег" aria-label="Найти участника" value="'+esc(search)+'"><select id="holdings-filter" aria-label="Занятость">'+[['all','Все'],['free','Без работы'],['working','Работают'],['away','Отсутствуют']].map(([v,n])=>'<option value="'+v+'"'+(filter===v?' selected':'')+'>'+n+'</option>').join('')+'</select></div><div class="holdings-select-row">'+button('Выбрать на странице','select-page')+button('Снять выбор','clear',false,!selected.size)+'<span>'+rows.length+' участников</span></div><div class="holdings-roster">'+(rows.slice(page*10,page*10+10).map(p=>personRow(p,staff)).join('')||'<p class="holdings-empty">Никого не найдено</p>')+'</div><div class="holdings-pager">'+button('←','prev',false,page===0)+'<span>'+(rows.length?page*10+1:0)+'–'+Math.min(rows.length,page*10+10)+' из '+rows.length+'</span>'+button('→','next',false,(page+1)*10>=rows.length)+'</div>'}
  function bulk(){return '<div class="holdings-bulk"><b>Выбрано: '+selected.size+(mission?' / 5':'')+'</b>'+button(mission?'Проверить отряд':'Назначить',mission?'quote':'assign',true,!selected.size||pending)+(mission?'':button('Снять с работ','remove',false,!selected.size||pending))+'</div>'}
  function overview(){let body=summary();if(data.recoveries.length)body+='<div class="note">🚨 Пропавших рабов: '+data.recoveries.length+'. Верни их через сообщение мини-игры в боте — таймер уже идёт.</div>';const slots=data.sites.reduce((n,s)=>n+Math.max(0,s.capacity-s.workers.length),0);body+='<div class="note">Без работы: '+data.people.filter(free).length+' · свободных мест: '+slots+'.</div><div class="holdings-buttons">'+button('Распределить свободных','free-workers',true)+button('Собрать экспедицию','raids',false,!data.arena_enabled)+'</div>';return body+data.sites.map(siteCard).join('')}
  function details(s){const income=s.income.reduce((n,r)=>n+r.net_income,0);return '<div class="holdings-section-head"><div><span class="holdings-kind">'+esc(s.emoji)+' '+esc(s.type_name)+' · ур. '+s.level+'</span><h2>'+esc(s.title)+'</h2></div>'+button('←','back-sites')+'</div>'+(s.description?'<p class="holdings-description">'+esc(s.description)+'</p>':'')+'<p class="muted">Места '+s.workers.length+'/'+s.capacity+' · базовая ставка активного работника '+s.active_rate+' ₣/ч, неактивного '+s.inactive_rate+' ₣/ч до налога. Редкость и особенность усиливают активную выработку. Управляющий +20% активной выручки; «Прораб крематория» добавляет ещё +5 п.п.</p><div class="holdings-buttons">'+button('Добавить работников','fill:'+s.id,true,s.workers.length>=s.capacity)+button('Заполнить свободными','auto:'+s.id,false,s.workers.length>=s.capacity||!data.people.some(free))+'</div>'+roster(data.people.filter(p=>p.business_id===s.id),true)+bulk()+'<details class="holdings-settings"><summary>Оформление и управление</summary><div class="holdings-buttons">'+button('Название','edit:'+s.id+':name')+button('Описание','edit:'+s.id+':description')+(s.business_type==='custom'?button('Должность работника','edit:'+s.id+':producer_title')+button('Должность управляющего','edit:'+s.id+':leader_title'):'')+(s.upgrade_price?button('Расширить · '+s.upgrade_price+' ₣','upgrade:'+s.id):'')+'</div><p class="muted">Чистый доход за последние 7 записанных дней: '+number(income)+' ₣.</p><button type="button" class="danger" data-h="close:'+s.id+'">Закрыть предприятие</button></details>'}
  function sitesScreen(){if(siteId&&site(siteId))return details(site(siteId));siteId=null;return '<div class="holdings-section-head"><div><h2>Предприятия</h2><p class="muted">'+data.sites.length+' / '+data.max_enterprises+' · разных типов</p></div>'+button('＋ Открыть','create',true,data.sites.length>=data.max_enterprises)+'</div>'+(data.sites.map(siteCard).join('')||'<p class="holdings-empty">Пока нет предприятий. Открой первое и назначь работников.</p>')}
  function expeditionCard(r){const q=r.quote,m=data.missions.find(m=>m.id===r.mission),active=r.status==='active',res=r.result;return '<article class="holdings-site"><div class="holdings-section-head"><h3>'+esc(m?.name||q.name)+'</h3><span class="pill">'+(active?'В пути':r.status==='cancelled'?'Отменена':res?.won?'Успех':'Неудача')+'</span></div><p class="muted">'+q.members.map(p=>esc(p.name)).join(' · ')+'</p>'+(active?'<p>До возвращения: <b data-h-timer="'+r.ends_at+'"></b></p><p class="muted">Возвращение: '+esc(date(r.ends_at))+'. Успех '+q.chance+'%. Исход будет раскрыт после завершения.</p>':'<p>Получено: <b>'+number(res?.francs)+' ₣</b>'+(res?.tax?' · налог '+res.tax+' ₣':'')+(res?.pages?' · '+res.pages+' стр. '+esc(rarities[res.page_rarity])+' редкости':'')+'</p><div class="holdings-outcomes">'+(res?.members||[]).map(p=>'<p>'+esc(q.members.find(m=>m.user_id===p.user_id)?.name||p.user_id)+' — '+esc(({returned:'вернулся',freed:'освободился',removed:'владение изменилось — исключён из награды',cancelled:'отмена без потерь'})[p.outcome]||p.outcome)+'</p>').join('')+'</div>')+'</article>'}
  function raidsScreen(){if(mission){const m=data.missions.find(m=>m.id===mission);return '<div class="holdings-section-head"><div><h2>Сбор отряда</h2><p class="muted">'+esc(m.name)+' · '+duration(m.duration)+' · до 5 участников</p></div>'+button('←','back-raids')+'</div><div class="note">Сила — условный рейтинг текущего персонажа арены. Выбор класса, снаряжённые навыки и пассивки фиксируются при отправке. Итоговые шансы увидишь перед подтверждением.</div>'+roster(data.people)+bulk()}const running=data.expeditions.some(r=>r.status==='active')||data.other_expedition_chat;return '<div class="holdings-section-head"><div><h2>Экспедиции</h2><p class="muted">Один отряд на владельца во всех чатах</p></div></div>'+(!data.arena_enabled?'<div class="note">Для новых экспедиций нужно включить арену в этом чате.</div>':'')+(data.other_expedition_chat?'<div class="note">Твой отряд уже в другом чате. Дождись возвращения.</div>':'')+data.expeditions.filter(r=>r.status==='active').map(expeditionCard).join('')+data.missions.map(m=>'<article class="holdings-site"><div class="holdings-section-head"><h3>'+esc(m.name)+'</h3><span class="pill">'+duration(m.duration)+'</span></div><p class="muted">Рекомендуемый уровень: '+esc(m.recommended)+'. Отряд 1–5 участников.</p><p>До '+number(m.francs*5)+' ₣ до налога · '+m.pages+' стр. '+esc(rarities[m.page_rarity])+' редкости</p>'+button('Собрать отряд','mission:'+m.id,true,Boolean(running)||!data.arena_enabled||!data.people.length)+'</article>').join('')+'<details class="holdings-settings"><summary>Правила и награды</summary><p class="muted">Слабые участники сильнее рискуют на сложных заданиях. Успех похода и возвращение каждого рассчитываются отдельно. Потерянный раб освобождается: уровень, вещи и персонаж не теряются. Работники не приносят доход во время отсутствия, но сохраняют рабочие места. Владелец получает добычу пропорционально вернувшимся; страницы — при успешном возвращении хотя бы одного. Участники получают личную выплату в пределах прежнего недельного лимита труда. Один участник может отправляться раз в 6 часов, ограничение общее для всех владельцев и чатов. Сами игроки могут продолжать бои на арене.</p></details>'+ (data.expeditions.some(r=>r.status!=='active')?'<h3>Последние походы</h3>'+data.expeditions.filter(r=>r.status!=='active').map(expeditionCard).join(''):'')}
  function traderReport(r){return '<details class="holdings-settings"><summary>'+esc(r.name)+' · оценка '+esc(date(r.created_at))+'</summary>'+identityDetails(r.identity)+'<p>'+(r.active?'Активен за последние 24 часа':'Неактивен за последние 24 часа')+' · '+esc(r.class_name)+' · ур. '+r.level+' · сила экспедиции '+r.power+'</p><div class="holdings-rate-grid">'+r.rates.map(c=>'<div><span>'+esc(c.name)+'</span><b>'+c.active_rate+' / '+c.inactive_rate+' ₣/ч</b></div>').join('')+'</div><p class="muted">Активный / неактивный производящий работник. Бонусы редкости и особенности уже учтены. Без управляющего и налогов. Управляющий сам не производит этот доход. Сила арены влияет на экспедиции, не на выработку.</p><p>Ориентир цены: <b>'+number(r.price_low)+'–'+number(r.price_high)+' ₣</b>.</p><p class="muted">Приблизительная оценка: суточная выработка + 0,4 × сила экспедиции, верхняя граница × 1,6. Это не гарантированная цена выкупа NPC. Снимок на дату оценки, не текущие показатели.</p>'+button('Обновить оценку · 50 ₣','trader-refresh:'+r.worker_id,false,data.balance<50)+'</details>'}
  function identityRules(){const rules=data.trader?.identity_rules;if(!rules)return '';return '<details class="holdings-settings"><summary>Редкости, шансы и все особенности</summary><p class="muted">Редкость выдаётся один раз и навсегда. Повышений, понижений и повторных бросков нет — ни за активность, ни за оценку, ни после продажи или повторного захвата. Одна случайная особенность тоже постоянная и не зависит от редкости.</p><div class="holdings-rarity-table"><table><thead><tr>'+rules.rarities.map(r=>'<th>'+esc(r.name)+'</th>').join('')+'</tr></thead><tbody><tr>'+(rules.chances||[50,28,15,6,1]).map(c=>'<td>'+c+'%</td>').join('')+'</tr></tbody></table></div><p class="muted">Бонус редкости к активной выработке: 0 / 10 / 25 / 45 / 70%. К силе экспедиции: 0 / 2 / 4 / 7 / 10%. Бонусы к выработке складываются, налог действует на итоговую выручку. В боях арены бонусов нет.</p>'+rules.traits.map(t=>'<div class="holdings-trait-entry"><b>'+esc(t.name)+'</b><p>'+esc(t.effect)+'</p><small>«'+esc(t.flavor)+'»</small></div>').join('')+'</details>'}
  function financeScreen(){
    const f=data.trader.finance;if(!f)return '';
    const loan=f.loan;
    const debt=loan?'<p>Осталось вернуть: <b>'+number(loan.remaining)+' ₣</b> из '+number(loan.total)+' ₣.</p><p>'+ (loan.status==='enslaved'?'Ты у NPC: весь поступающий доход погашает долг. Дополнительно списывается 1% исходного долга за час.':'Срок возврата: '+esc(date(loan.due_at))+'. После предупреждения NPC взыщет рабов, а при нехватке — тебя.')+'</p>'+button('Внести платёж','finance-repay',true,data.balance<1):'<p>Лимит на аккаунт: <b>'+number(f.limit)+' ₣</b>. Большее из 2 000 ₣ и удвоенной суммы кошельков.</p>'+button('Взять в долг','finance-borrow',true);
    const stock=f.offers.map(o=>'<div class="holdings-market-row"><div><b>'+esc(o.name)+'</b><small>'+esc(o.reason==='debtor'?'Должник. Покупка закрывает его долг; первоначальный самостоятельный выкуп равен цене покупки и снижается до 100 ₣ за 72 часа.':'Работник у NPC. Цена включает наценку 20%.')+'</small></div><div><strong>'+number(o.price)+' ₣</strong>'+button(o.worker===data.actor_id?'Выкупиться':'Купить у NPC','finance-buy:'+o.worker,false,data.balance<o.price)+'</div></div>').join('');
    return '<article class="holdings-site"><h3>🎰 Деп рабов</h3><p>17% — получаешь ×5 стоимости франками, раб остаётся. Иначе он переходит к NPC и продаётся с наценкой 20%. Неоценённый считается по минимальной стоимости — 100 ₣, редкость не раскрывается.</p><p class="muted">Одного раба за раз. Пропавшие, участники экспедиции и выставленные на продажу недоступны. Общий кулдаун с депом франков; после ставки рабом — 5 минут.</p>'+button('Выбрать ставку','finance-wager',true,!traderCandidates().length)+'</article><article class="holdings-site"><h3>💰 Ростовщик</h3><p class="muted">Только игровые франки. Один долг во всех чатах. Переплата 15% однократно, срок 72 часа. Деньги можно переводить и депать. После просрочки возможна потеря рабов или собственная зависимость от NPC.</p>'+debt+(f.notices.length?'<details><summary>Сообщения ростовщика</summary>'+f.notices.map(n=>'<p>'+esc(n)+'</p>').join('')+'</details>':'')+'</article><article class="holdings-site"><h3>Работники у NPC</h3>'+(stock||'<p class="muted">Пока никого нет.</p>')+'</article>';
  }
  function traderScreen(){
    const t=data.trader;if(!t)return '<p class="holdings-empty">Обнови владения, чтобы открыть торговца.</p>';
    const own=t.listings.filter(l=>l.seller_id===data.actor_id).length;
    const market=t.listings.map(l=>'<div class="holdings-market-row"><div><b>'+esc(l.name)+'</b> '+identityBadge(l.identity)+'<small>'+esc(l.identity?.trait_name)+'</small><small>'+esc(l.identity?.trait_effect)+'</small><small>'+esc(l.seller_name)+' · до '+esc(date(l.expires_at))+'</small><small>'+(l.seller_id===data.actor_id?'Тебе после комиссии: '+number(l.price-l.fee)+' ₣':'Цена фиксирована; рабочее место не передаётся')+'</small></div><div><strong>'+number(l.price)+' ₣</strong>'+button(l.seller_id===data.actor_id?'Снять':'Купить',(l.seller_id===data.actor_id?'trader-cancel:':'trader-buy:')+l.id,false,l.seller_id!==data.actor_id&&(data.balance<l.price||l.worker_id===data.actor_id))+'</div></div>').join('');
