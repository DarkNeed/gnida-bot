async function openMenu(){
  raidCurrent=null;closeRaidDetails();
  closeEffect();statusViews=null;
  if(!chat)return;lastSeq=0;current=null;token="";
  try{menuScreen(await api("/api/menu/"+chat));}catch(error){toast(error.message);}
}
async function menuAction(action,extra={}){
  if(demo){toast('Демо: покупки и изменения не сохраняются.');menuScreen(menu);return;}
  if(busy)return;busy=true;
  try{
    const response=await api("/api/menu/"+chat,{action,...extra});
    if(response.mirror){mirrorAbandonConfirm=false;mirrorScreen(response.mirror);}
    else if(response.token){token=response.token;current=null;lastSeq=0;battleScreen(await api("/api/battle/"+token));}
    else{toast(({crafted:"Создано.",low_level:"Недостаточный уровень.",not_enough_material:"Не хватает сырья.",no_candy:"Нет конфет.",given:"Конфета выдана.",created:"Создано.",granted:"Выдано.",invalid_definition:"Некорректное описание.",exists:"Такой ID уже есть."})[response.notice]||response.notice);menuScreen(response.menu);}
    return true;
  }catch(error){toast(error.message);return false;}finally{busy=false;}
}
async function saveSprite(reset=false){
  if(busy||(!reset&&!spriteDraft))return;
  busy=true;
  document.querySelectorAll(".content button,.tabs button,#sprite-file").forEach(b=>b.disabled=true);
  try{
    const response=await fetch("/api/menu/"+chat+"/sprite",{method:reset?"DELETE":"POST",headers:{"X-Telegram-Init-Data":tg?.initData||"",...(!reset?{"Content-Type":"image/png","X-Pixel-Art":String(document.getElementById("sprite-pixels").checked)}:{})},body:reset?undefined:spriteDraft.file});
    const data=await response.json().catch(()=>({error:"Сервер недоступен. Попробуй ещё раз."}));
    if(!response.ok)throw new Error(data.error||"Не удалось сохранить спрайт.");
    clearSpriteDraft();page="personal";menuScreen(data.menu);toast(data.notice);
  }catch(error){toast(error.message);}finally{
    busy=false;document.querySelectorAll(".content button,.tabs button,#sprite-file").forEach(b=>b.disabled=false);
    const upload=document.querySelector('[data-do="upload_sprite"]');if(upload)upload.disabled=!spriteDraft;
  }
}
app.addEventListener("error",event=>{const img=event.target;if(img.tagName==="IMG"&&img.dataset.fallback){const fallback=img.dataset.fallback;delete img.dataset.fallback;img.classList.remove("pixel-art");img.src=fallback;}},true);
app.addEventListener("change",event=>{
  if(event.target.id==="sprite-pixels"){document.getElementById("upload-preview")?.classList.toggle("pixel-art",event.target.checked);return;}
  if(event.target.id!=="sprite-file"||busy)return;
  const file=event.target.files?.[0];if(!file)return;
  if(file.size>2*1024*1024||!file.size){toast("PNG должен весить не больше 2 МБ.");event.target.value="";return;}
  if(!/\.png$/i.test(file.name)){toast("Выбери PNG с прозрачным фоном.");event.target.value="";return;}
  clearSpriteDraft();spriteDraft={file,url:URL.createObjectURL(file)};
  const preview=document.getElementById("upload-preview");preview.dataset.fallback=sprite(menu.personal.sprite);preview.src=spriteDraft.url;preview.classList.toggle("pixel-art",document.getElementById("sprite-pixels").checked);
  document.getElementById("sprite-filename").textContent=file.name;
  document.querySelector('[data-do="upload_sprite"]').disabled=false;
});
app.addEventListener("click",async event=>{
  const effect=event.target.closest('[data-status-id]');if(effect){showEffect(effect.dataset.statusSide,effect.dataset.statusId);return;}
  const inspect=event.target.closest('[data-inspect]');if(inspect){showStats(inspect.dataset.inspect);return;}
  const b=event.target.closest("button");if(!b||b.disabled||busy)return;
  if(b.dataset.skill){await action("skill",{skill:b.dataset.skill});return;}
  const id=b.dataset.do||"",colon=id.indexOf(":"),cmd=colon<0?id:id.slice(0,colon),arg=colon<0?"":id.slice(colon+1);
  if(["accept","cancel","refuse","consent"].includes(cmd)){await action(cmd);return;}
  if(cmd==="select"||cmd==="selected"){await action("select",{fighter:Number(arg),controlled:document.getElementById("control").checked});return;}
  if(cmd==="potion"||cmd==="surrender"){await action("skill",{skill:cmd});return;}
  if(cmd==="menu"||cmd==="refresh"){closeEffect();statusViews=null;closeStats();if(demo){if(cmd==='menu')page='personal';startDemoMenu();return;}await openMenu();return;}
  if(cmd==="tab"){page=arg;menuScreen(menu);return;}
  if(cmd==="appearance"){clearSpriteDraft();page="appearance";menuScreen(menu);return;}
  if(cmd==="choose_sprite"){document.getElementById("sprite-file").click();return;}
  if(cmd==="upload_sprite"||cmd==="reset_sprite"){await saveSprite(cmd==="reset_sprite");return;}
  if(cmd==="profile"){profileId=Number(arg);page=page==="personal"?"personalProfile":"slaveProfile";menuScreen(menu);return;}
  if(cmd==='resetprofile'){const p=activeProfile();if(!p)return;resetPending={user:p.user_id,personal:p.personal,name:p.name||p.class_name};page='resetConfirm';menuScreen(menu);return;}
  if(cmd==='cancelreset'){page=resetPending?.personal?'personalProfile':'slaveProfile';resetPending=null;menuScreen(menu);return;}
  if(cmd==='confirmreset'){const pending=resetPending;if(!pending)return;if(await menuAction('reset_class',{user:pending.user,personal:pending.personal,value:true})){page=pending.personal?'personalProfile':'slaveProfile';resetPending=null;menuScreen(menu);}return;}
  if(cmd==="admin"){page="admin";menuScreen(menu);return;}
  if(cmd==="battle"){token=arg;current=null;lastSeq=0;battleScreen(await api("/api/battle/"+token));return;}
  if(cmd==='mirror'){await openMirror(arg);return;}
  if(cmd==='mirrorstart'){const [mode,user]=arg.split(':');await menuAction('mirror_start',{fighter:Number(user),personal:mode==='p'});return;}
  if(cmd==='mirrorchoice'){const [action,value]=arg.split(':');await mirrorAction(action,value);return;}
  if(cmd==='mirroraction'){await mirrorAction(arg);return;}
  if(cmd==='mirrorabandon'||cmd==='mirrorback'){mirrorAbandonConfirm=cmd==='mirrorabandon';mirrorScreen(mirrorRun);return;}
  if(cmd==="waste"){await menuAction("wasteland",{fighter:Number(arg),personal:page==="personal"});return;}
  if(cmd==="next"){await menuAction("wasteland",{fighter:current.a_fighter,previous:token});return;}
  if(cmd==="buy"){await menuAction('buy_item',{offer:Number(arg)});return;}
  if(cmd==="useitem"){
    const item=(menu.inventory||[]).find(i=>i.id===Number(arg));if(!item)return;
    const [mode,id]=document.getElementById('item-target-'+arg).value.split(':');
    const target=[menu.personal,...menu.slaves,menu.self_slave].filter(Boolean).find(p=>p.user_id===Number(id)&&p.personal===(mode==='p'));
    if(item.kind==='class'){classUsePending={item:item.id,user:Number(id),personal:mode==='p',name:target?.name||(mode==='p'?'Мой личный персонаж':'Мой персонаж-раб')};page='classConfirm';menuScreen(menu);return;}
    if(target&&(item.kind==='skill'||item.kind==='passive')){
      const known=item.kind==='skill'?target.skills:(target.passives||[]),limit=item.kind==='skill'?6:3;
      if(known.length>=limit&&!known.some(s=>s.skill_id===item.content_id)){
        skillUsePending={item:item.id,user:Number(id),personal:mode==='p'};page='skillReplace';menuScreen(menu);return;
      }
    }
    await menuAction('use_item',{item:item.id,user:Number(id),personal:mode==='p'});return;
  }
  if(cmd==="confirmitem"){const pending=classUsePending;if(!pending)return;page='inventory';await menuAction('use_item',{item:pending.item,user:pending.user,personal:pending.personal,confirm:true});return;}
  if(cmd==='replaceitem'){const pending=skillUsePending;if(!pending)return;if(await menuAction('use_item',{...pending,replace_skill:arg})){skillUsePending=null;page='inventory';menuScreen(menu);}return;}
  if(cmd==="equip"||cmd==="unequip"){await menuAction("equipment",{user:Number(arg),equipped:cmd==="equip"});return;}
  const p=activeProfile();
  if(cmd==='choiceback'){page='slaves';menuScreen(menu);return;}
  if(cmd==='progression'){
    if(!p?.progression_choice?.can_choose)return;
    if(!p.progression_choice.options.some(c=>c.id===arg))return;
    await menuAction('progression',{user:p.user_id,personal:p.personal,value:arg});return;
  }
  if(cmd==='archclass'){
    if(!p)return;
    const a=(p.archclass_options||[]).find(a=>a.id===arg);if(!a)return;
    if(!window.confirm('Выбрать «'+a.name+'»? Другая ветка станет доступна только после смены или сброса класса.'))return;
    await menuAction('archclass',{user:p.user_id,personal:p.personal,value:arg});return;
  }
  if(['forget_skill','forget_passive','learn_skill','learn_passive'].includes(cmd)){
    if(cmd.startsWith('forget_')&&!window.confirm('Забыть навык и освободить место? Его можно изучить повторно.'))return;
    await menuAction(cmd,{user:p.user_id,personal:p.personal,value:arg});return;
  }
  if(cmd==="class"||cmd==="hidden"){await menuAction("class",{user:p.user_id,personal:p.personal,value:cmd==="hidden"?document.getElementById("hidden-class").value:arg});return;}
  if(cmd==="toggle"){if(p.loadout.includes(arg))p.loadout=p.loadout.filter(k=>k!==arg);else if(p.loadout.length<4)p.loadout.push(arg);else toast("Не больше четырёх навыков.");menuScreen(menu);return;}
  if(cmd==="save"){await menuAction("loadout",{user:p.user_id,personal:p.personal,value:p.loadout});return;}
  if(cmd==="togglepassive"){p.passive_loadout=p.passive_loadout||[];if(p.passive_loadout.includes(arg))p.passive_loadout=p.passive_loadout.filter(k=>k!==arg);else if(p.passive_loadout.length<2)p.passive_loadout.push(arg);else toast('Максимум две пассивки.');menuScreen(menu);return;}
  if(cmd==="savepassives"){await menuAction('passives',{user:p.user_id,personal:p.personal,value:p.passive_loadout||[]});return;}
  if(cmd==="candy"){await menuAction("candy",{user:p.user_id});return;}
  if(cmd==="create_content"||cmd==="grant_content"){
    let definition={};try{if(cmd==="create_content")definition=JSON.parse(document.getElementById("content-json").value);}catch{toast("Не удалось разобрать JSON.");return;}
    await menuAction(cmd,{type:document.getElementById("content-type").value,id:document.getElementById("content-id").value,definition,user:Number(document.getElementById("content-user").value),personal:document.getElementById("grant-personal").checked});
