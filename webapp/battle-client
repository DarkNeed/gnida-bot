  const remaining=Math.max(0,Math.ceil((current.deadline*1000-Date.now()-serverClockOffset)/1000));
  el.textContent=remaining?'⏳ '+String(Math.floor(remaining/60)).padStart(2,'0')+':'+String(remaining%60).padStart(2,'0')+' · затем пропуск хода':'Время вышло · обновляем ход…';
  el.classList?.toggle('urgent',remaining<=30);
}
