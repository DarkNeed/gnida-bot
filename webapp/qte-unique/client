        ctx.translate(g.x,g.y);ctx.rotate(t*3);ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(-10,0);ctx.lineTo(10,0);ctx.moveTo(0,-10);ctx.lineTo(0,10);ctx.stroke();
      }else if(g.motif==='bone'||g.motif==='ice'||g.motif==='train'){
        ctx.translate(g.x,g.y);ctx.rotate(Math.atan2(g.vy,g.vx));ctx.fillRect(-g.r*2,-g.r,g.r*4,g.r*2);
      }else{
        mark(g.x,g.y,g.r,color);if(g.motif==='ghost'){arc(g.x,g.y,g.r+4,0,Math.PI*2,color,1);}if(g.motif==='orb'){arc(g.x,g.y,g.r+5,0,Math.PI*2,color,2);}
