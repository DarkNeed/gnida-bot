}
async function openMenu(){
  if(!chat)return;lastSeq=0;current=null;token="";
  try{menuScreen(await api("/api/menu/"+chat));}catch(error){toast(error.message);}
}
async function menuAction(action,extra={}){
  if(busy)return;busy=true;
  try{
    const response=await api("/api/menu/"+chat,{action,...extra});
    if(response.token){token=response.token;current=null;lastSeq=0;battleScreen(await api("/api/battle/"+token));}
    else{toast(({crafted:"Создано.",low_level:"Недостаточный уровень.",not_enough_material:"Не хватает сырья.",no_candy:"Нет конфет.",given:"Конфета выдана.",created:"Создано.",granted:"Выдано.",invalid_definition:"Некорректное описание.",exists:"Такой ID уже есть."})[response.notice]||response.notice);menuScreen(response.menu);}
  }catch(error){toast(error.message);}finally{busy=false;}
}
app.addEventListener("click",async event=>{
  const b=event.target.closest("button");if(!b||b.disabled||busy)return;
  if(b.dataset.skill){await action("skill",{skill:b.dataset.skill});return;}
  const id=b.dataset.do||"",[cmd,arg]=id.split(":");
  if(["accept","cancel","refuse","consent"].includes(cmd)){await action(cmd);return;}
  if(cmd==="select"||cmd==="selected"){await action("select",{fighter:Number(arg),controlled:document.getElementById("control").checked});return;}
  if(cmd==="potion"||cmd==="surrender"){await action("skill",{skill:cmd});return;}
  if(cmd==="menu"||cmd==="refresh"){if(demo){toast("Демо интерфейса. В Telegram здесь откроется меню.");return;}await openMenu();return;}
  if(cmd==="tab"){page=arg;menuScreen(menu);return;}
  if(cmd==="profile"){profileId=Number(arg);page=page==="personal"?"personalProfile":"slaveProfile";menuScreen(menu);return;}
  if(cmd==="admin"){page="admin";menuScreen(menu);return;}
  if(cmd==="battle"){token=arg;current=null;lastSeq=0;battleScreen(await api("/api/battle/"+token));return;}
  if(cmd==="waste"){await menuAction("wasteland",{fighter:Number(arg),personal:page==="personal"});return;}
  if(cmd==="next"){await menuAction("wasteland",{fighter:current.a_fighter,previous:token});return;}
  if(cmd==="craft"){await menuAction("craft",{item:arg});return;}
  const p=activeProfile();
  if(cmd==="class"||cmd==="hidden"){await menuAction("class",{user:p.user_id,personal:p.personal,value:cmd==="hidden"?document.getElementById("hidden-class").value:arg});return;}
  if(cmd==="toggle"){if(p.loadout.includes(arg))p.loadout=p.loadout.filter(k=>k!==arg);else if(p.loadout.length<4)p.loadout.push(arg);else toast("Не больше четырёх навыков.");menuScreen(menu);return;}
  if(cmd==="save"){await menuAction("loadout",{user:p.user_id,personal:p.personal,value:p.loadout});return;}
  if(cmd==="candy"){await menuAction("candy",{user:p.user_id});return;}
  if(cmd==="create_content"||cmd==="grant_content"){
    let definition={};try{if(cmd==="create_content")definition=JSON.parse(document.getElementById("content-json").value);}catch{toast("Не удалось разобрать JSON.");return;}
    await menuAction(cmd,{type:document.getElementById("content-type").value,id:document.getElementById("content-id").value,definition,user:Number(document.getElementById("content-user").value),personal:document.getElementById("grant-personal").checked});
  }
});
app.addEventListener("input",event=>{if(page==="admin"&&event.target.id)adminDraft[event.target.id]=event.target.type==="checkbox"?event.target.checked:event.target.value;});
async function poll(){
  if(polling||busy||!token||demo||document.hidden||current?.status!=="active"&&current?.status!=="pending")return;
  polling=true;
  try{
    const data=await api("/api/battle/"+token);
    if(!busy&&token===data.token&&(!current||data.revision>current.revision)){busy=true;try{await applyBattle(data);}finally{busy=false;}}
  }catch(error){toast(error.message);}finally{polling=false;}
}
function startDemo(){
  const skill=(id,name,type,cost)=>({skill_id:id,name,damage_type:type,cost});
  const side=(name,classId,level)=>({name,class_name:classId==="nerd"?"Задрот":"Оборванец",sprite:classId,class_id:classId,level,hp:60,resource:100,stats:{max_hp:60,resource_max:100},resource_name:classId==="nerd"?"Энергосы":"Выносливость",controller_id:1,controlled:false,loadout:["bum_punch"],cooldowns:{},potion_used:false,skill_details:[skill("bum_punch","Удар бомжа","physical",0),skill("humiliate","Унизить","magic",20),skill("dust","Пыль в глаза",null,20),skill("store","Сходить в магаз",null,0)]});
  battleScreen({token:"demo",chat_id:-1,mode:"personal",status:"active",revision:0,stake:50,actor_id:1,own_side:"a",state:{turn:1,active_side:"a",finished:false,sides:{a:side("Мистер Недосып","nerd",7),b:side("Пустошь","ragamuffin",7)},log:[]}});
}
function configureViewport(){
  tg?.ready();tg?.expand();
  try{
    if(tg?.isVersionAtLeast?.("8.0")){
      const mobile=tg.platform==="android"||tg.platform==="ios";
      if(mobile&&!tg.isFullscreen)tg.requestFullscreen?.();
      else if(!mobile&&tg.isFullscreen)tg.exitFullscreen?.();
    }
  }catch{}
  try{tg?.setHeaderColor("#0c1324");tg?.setBackgroundColor("#0c1324");}catch{}
}
async function boot(){
  configureViewport();
  if(demo){startDemo();return;}
  const start=tg?.initDataUnsafe?.start_param||new URLSearchParams(location.search).get("tgWebAppStartParam")||"";
  try{
    if(start.startsWith("b_")){token=start.slice(2);const data=await api("/api/battle/"+token);lastSeq=data.state?.log.at(-1)?.seq||0;battleScreen(data);}
    else if(/^menu_-?\d+$/.test(start)){chat=Number(start.slice(5));await openMenu();}
    else app.innerHTML='<div class="loading"><h2>Открой арену из бота</h2><p class="muted">Кнопка «Арена» в /menu или «Открыть бой» под вызовом в чате.</p></div>';
  }catch(error){app.innerHTML='<div class="loading"><h2>Не удалось открыть арену</h2><p>'+esc(error.message)+'</p></div>';}
}
setInterval(poll,1800);
document.addEventListener("visibilitychange",()=>{if(!document.hidden)poll();});
boot();
