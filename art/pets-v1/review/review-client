/* Approval-only gacha scene. No payments, inventory, RNG odds or combat writes. */
(() => {
  'use strict';
  const $ = id => document.getElementById(id);
  const stage=$('stage'),open=$('open'),skip=$('skip'),choice=$('petChoice');
  const families={cutie:'Милашка',jock:'Качок',nerd:'Задрот',thumb:'Большой палец',index:'Указательный палец',middle:'Средний палец',ring:'Кольцо',pinky:'Звёздный клинок'};
  const profiles={
    common:{name:'ОБЫЧНЫЙ',color:'#acbdce',stars:'◆',count:35},
    rare:{name:'РЕДКИЙ',color:'#72c8ef',stars:'◆◆',count:60},
    epic:{name:'ЭПИЧЕСКИЙ',color:'#c49bea',stars:'◆◆◆',count:85},
    legendary:{name:'ЛЕГЕНДАРНЫЙ',color:'#f0c775',stars:'◆◆◆◆',count:120},
  };
  let pets=[],opening=false,generation=0,last=null,selected=null,profile=profiles.legendary;
  let particles=[],frame=0,previous=0,audioContext=null;
  const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
  $('gentle').checked=reduced.matches;
  const gentle=()=> $('gentle').checked;
  const sprite=pet=>'/pets/'+encodeURIComponent(pet.id)+'.png';
  const wait=ms=>new Promise(resolve=>setTimeout(resolve,ms));
  const phase=name=>{
    stage.dataset.phase=name;
    stage.querySelector('.reveal').setAttribute('aria-hidden',String(!['reveal','result'].includes(name)));
  };
  const canvas=$('particles'),ctx=canvas.getContext('2d');

  function resize(){
    const box=stage.getBoundingClientRect(),ratio=Math.min(2,window.devicePixelRatio||1);
    canvas.width=Math.round(box.width*ratio);canvas.height=Math.round(box.height*ratio);
    ctx?.setTransform(ratio,0,0,ratio,0,0);
  }
  new ResizeObserver(resize).observe(stage);
  function burst(count){
    if(gentle()||!ctx)return;
    const box=stage.getBoundingClientRect();
    for(let i=0;i<count;i++){
      const angle=Math.random()*Math.PI*2,speed=30+Math.random()*180;
      particles.push({x:box.width/2,y:box.height*.48,vx:Math.cos(angle)*speed,
        vy:Math.sin(angle)*speed-35,life:1.2+Math.random()*1.1,size:1+Math.random()*2.1});
    }
    if(!frame){previous=performance.now();frame=requestAnimationFrame(draw);}
  }
  function draw(now){
    frame=0;
    const dt=Math.min(.04,(now-previous)/1000);previous=now;
    const box=stage.getBoundingClientRect();ctx.clearRect(0,0,box.width,box.height);
    particles=particles.filter(p=>p.life>0);
    ctx.fillStyle=profile.color;
    for(const p of particles){
      p.life-=dt;p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=23*dt;
      ctx.globalAlpha=Math.min(1,Math.max(0,p.life));
      ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,Math.PI*2);ctx.fill();
    }
    ctx.globalAlpha=1;
    if(particles.length&&!document.hidden)frame=requestAnimationFrame(draw);
  }
  function clearParticles(){
    cancelAnimationFrame(frame);frame=0;particles=[];
    const box=stage.getBoundingClientRect();ctx?.clearRect(0,0,box.width,box.height);
  }
  document.addEventListener('visibilitychange',()=>{
    clearParticles();
    if(document.hidden&&opening){generation++;finish();}
    if(document.hidden)audioContext?.suspend().catch(()=>{});
  });
  function sound(kind){
    if(!$('sound').checked||document.hidden)return;
    try{
      const AudioContext=window.AudioContext||window.webkitAudioContext;if(!AudioContext)return;
      audioContext||=new AudioContext();audioContext.resume().catch(()=>{});
      const notes=kind==='reveal'?[196,293.66,392,587.33]:kind==='charge'?[98,146.83]:[65.41];
      for(const [i,hz] of notes.entries()){
        const oscillator=audioContext.createOscillator(),gain=audioContext.createGain();
        const start=audioContext.currentTime+i*.08,duration=kind==='reveal'?.7:.3;
        oscillator.type=kind==='reveal'?'triangle':'sawtooth';oscillator.frequency.value=hz;
        gain.gain.setValueAtTime(0,start);gain.gain.linearRampToValueAtTime(.045,start+.02);
        gain.gain.exponentialRampToValueAtTime(.001,start+duration);
        oscillator.connect(gain);gain.connect(audioContext.destination);oscillator.start(start);oscillator.stop(start+duration+.02);
        oscillator.onended=()=>{oscillator.disconnect();gain.disconnect();};
      }
    }catch{/* Audio is optional and never prevents the reveal. */}
  }
  function controls(busy){
    open.disabled=busy;choice.disabled=busy;$('rarityChoice').disabled=busy;
    $('summonChosen').disabled=busy;skip.hidden=!busy;
    open.innerHTML=busy?'Открываем…':'Открыть посылку <span>↗</span>';
  }
  function finish(){
    if(!selected)return;
    opening=false;phase('result');last=selected;controls(false);
    $('phaseCaption').textContent='Спутник найден. Теперь неприятности — не только ваши.';
    $('lastResult').hidden=false;$('resultName').textContent=last.name;
    $('resultEffect').textContent=last.effect;
    $('stageLabel').textContent='ПОСЫЛКА ОТКРЫТА';
    $('heroName').setAttribute('tabindex','-1');$('heroName').focus({preventScroll:true});
  }
  async function summon(forced){
    if(opening||!pets.length)return;
    const requested=forced||pets.find(p=>p.id===choice.value);
    const index=new Uint32Array(1);crypto.getRandomValues(index);
    selected=requested||pets[index[0]%pets.length];
    const rarity=$('rarityChoice').value==='auto'?selected.rarity:$('rarityChoice').value;
    profile=profiles[rarity]||profiles.rare;
    stage.style.setProperty('--tone',profile.color);
    $('rarity').textContent=profile.name;$('heroName').textContent=selected.name;
    $('heroQuote').textContent='«'+selected.quote+'»';
    $('heroPet').alt=selected.name;$('heroPet').src=sprite(selected);
    opening=true;controls(true);clearParticles();const id=++generation;
    $('stageLabel').textContent='ДОСТАВКА С НЕИЗВЕСТНЫМИ ПОСЛЕДСТВИЯМИ';
    $('phaseCaption').textContent='Кажется, оно не согласно с условиями перевозки.';
    phase('idle');sound('knock');
    try{await $('heroPet').decode();}catch{
      if(id!==generation)return;
      opening=false;controls(false);phase('idle');
      $('phaseCaption').textContent='Спрайт не загрузился. Попробуйте ещё раз.';return;
    }
    if(id!==generation)return;
    if(gentle()){
      phase('reveal');sound('reveal');await wait(300);if(id===generation)finish();return;
    }
    await wait(100);if(id!==generation)return;phase('shake');
    await wait(950);if(id!==generation)return;phase('charge');sound('charge');
    $('phaseCaption').textContent='Печать не выдерживает.';
    await wait(1150);if(id!==generation)return;phase('burst');burst(profile.count);sound('reveal');
    await wait(500);if(id!==generation)return;phase('reveal');
    $('phaseCaption').textContent='Знакомьтесь. Ответственность за ущерб — на вас.';
    await wait(1000);if(id===generation)finish();
  }
  open.addEventListener('click',()=>summon());
  skip.addEventListener('click',()=>{generation++;clearParticles();finish();});
  $('gentle').addEventListener('change',()=>{
    document.body.classList.toggle('gentle',gentle());
    if(gentle()&&opening){generation++;clearParticles();finish();}
  });
  const dialog=$('petDialog');let inspecting=null;
  function inspect(pet){
    inspecting=pet;$('detailImage').src=sprite(pet);$('detailImage').alt=pet.name;
    $('detailFamily').textContent='СИНЕРГИЯ · '+families[pet.affinity];
    $('detailName').textContent=pet.name;$('detailEffect').textContent=pet.effect;
    $('detailQuote').textContent='«'+pet.quote+'»';
    $('lightBackground').checked=false;$('portrait').classList.remove('light');
    if(!dialog.open)dialog.showModal();
  }
  dialog.querySelector('.dialog-close').addEventListener('click',()=>dialog.close());
  dialog.addEventListener('click',event=>{if(event.target===dialog){const b=dialog.getBoundingClientRect();if(event.clientX<b.left||event.clientX>b.right||event.clientY<b.top||event.clientY>b.bottom)dialog.close();}});
  $('lightBackground').addEventListener('change',()=>$('portrait').classList.toggle('light',$('lightBackground').checked));
  $('summonChosen').addEventListener('click',()=>{if(!opening&&inspecting){choice.value=inspecting.id;dialog.close();stage.scrollIntoView({behavior:gentle()?'instant':'smooth',block:'center'});summon(inspecting);}});
  $('inspectResult').addEventListener('click',()=>{if(last)inspect(last);});
  document.addEventListener('keydown',event=>{if(event.key==='Escape'&&opening&&!dialog.open){generation++;clearParticles();finish();}});
  async function boot(){
    open.disabled=true;
    try{
      const response=await fetch('/pets.json');if(!response.ok)throw new Error('Catalog failed');
      pets=await response.json();
      for(const pet of pets){
        const option=document.createElement('option');option.value=pet.id;option.textContent=pet.name;choice.append(option);
        const card=document.createElement('button');card.className='pet-card';card.setAttribute('aria-label','Посмотреть '+pet.name);
        card.style.setProperty('--card-tone',profiles[pet.rarity].color);
        const rarity=document.createElement('span');rarity.className='card-rarity';rarity.textContent=profiles[pet.rarity].stars;
        const image=document.createElement('img');image.src=sprite(pet);image.alt=pet.name;image.loading='lazy';
        const family=document.createElement('div');family.className='card-family';family.textContent=families[pet.affinity];
        const name=document.createElement('h3');name.textContent=pet.name;
        const effect=document.createElement('p');effect.textContent=pet.effect;
        card.append(rarity,image,family,name,effect);card.addEventListener('click',()=>inspect(pet));$('gallery').append(card);
      }
      document.body.classList.toggle('gentle',gentle());controls(false);
    }catch{$('phaseCaption').textContent='Не удалось загрузить галерею. Обновите страницу.';}
  }
  boot();
})();
