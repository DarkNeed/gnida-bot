    if(cmd==='close'){const s=site(arg);modal('Закрыть «'+s.title+'»?','<p>Работников: '+s.workers.length+'. Они будут сняты с должностей, но останутся твоими рабами.</p><div class="note">Накопленный доход начислится перед закрытием. Стоимость открытия и улучшений не возвращается. Место в лимите предприятий освободится.</div><p class="muted">Активная экспедиция или поиск пропавшего продолжатся, но рабочего места здесь больше не будет.</p>',{label:'Закрыть предприятие',action:'confirm-close:'+s.id});return}
