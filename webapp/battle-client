function forgeOdds(odds){return '<div class="forge-wallet">'+Object.entries(odds).filter(([,n])=>n>0).map(([r,n])=>'<span>'+rarityBadge(r)+' '+Number(n.toFixed(2))+'%</span>').join('')+'</div>';}
function forgeChoices(f,kind,odds){return '<details><summary>Все возможные результаты</summary><p class="muted">Сначала определяется редкость. Внутри неё шансы навыков равные. Может выпасть уже имеющийся или отданный навык. Боссовых, веточных и эксклюзивных навыков здесь нет.</p><div class="stack">'+f.pools.filter(p=>p.kind===kind&&(!odds||odds[p.rarity]>0)).map(p=>'<div>'+rarityBadge(p.rarity)+(odds?' · '+Number(odds[p.rarity].toFixed(2))+'%':'')+p.choices.map(c=>'<div><b>'+esc(c.name)+'</b>'+forgeInfo(c)+'</div>').join('')+'</div>').join('')+'</div></details>';}
function forgeFusion(f,rows,items){const count=items.reduce((n,i)=>n+i.quantity,0),odds=Object.fromEntries(f.rarities.map(r=>[r.id,0]));let cost=0;for(const i of items){const row=rows.find(r=>r.id===i.id),rule=f.rarities.find(r=>r.id===row.rarity);cost+=rule.rewrite_price*i.quantity;for(const r of f.rarities)odds[r.id]+=(f.fusion_odds[row.kind][row.rarity][r.id]||0)*i.quantity/(count||1);}return {odds,price:Math.ceil(cost/(count||1)),count};}
function forgeSelection(f){const rows=f.inventory.filter(i=>i.can_rewrite&&i.kind===forgePool),items=[];let bad=false;for(const row of rows){const count=Number(document.getElementById('forge-rewrite-'+row.id)?.value);if(!Number.isInteger(count)||count<0||count>Math.min(3,row.quantity))bad=true;if(count>0)items.push({id:row.id,quantity:count});}return {rows,items,bad,...forgeFusion(f,rows,items)};}
