function raidRewardStatus(status){
  if(status?.disabled)return 'Награды отключены';
  if(status?.full_reward!==false)return 'Полная награда доступна';
  const remaining=Number(status.cooldown_remaining||0);
  return 'Повторная награда 20%'+(remaining>0?' · полная через '+Math.ceil(remaining/60)+' мин.':'');
}
