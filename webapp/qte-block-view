/* Read-only live presentation; damage and block outcomes are replayed by Python. */
(()=>{
  window.QTEBlockView={draw};
  const staffArt=typeof Image==='function'?new Image():null;
  if(staffArt)staffArt.src='/static/assets/nazarick/staff_floating.png';
  function draw(ctx,canvas,s){
    if(window.QTECasinoView?.drawBlock(ctx,canvas,s))return;
    const E=QTEUnique,cx=360,cy=200,t=s.time,C=s.chaplain;
    function text(value,x,y,color='#b9cddd',size=15){ctx.font=`500 ${Math.max(size,Math.min(23,7200/Math.max(1,canvas.clientWidth)))}px Segoe UI,Arial,sans-serif`;ctx.fillStyle=color;ctx.textAlign='center';ctx.fillText(value,x,y);}
    function line(x,y,x2,y2,c,w=1){ctx.strokeStyle=c;ctx.lineWidth=w;ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x2,y2);ctx.stroke();}
    function arc(r,a,b,c,w=2){ctx.strokeStyle=c;ctx.lineWidth=w;ctx.beginPath();ctx.arc(cx,cy,r,a,b);ctx.stroke();}
    ctx.clearRect(0,0,720,400);ctx.fillStyle='#09131f';ctx.fillRect(0,0,720,400);
    for(let x=0;x<=720;x+=40)line(x,0,x,400,'#162b3b');for(let y=0;y<=400;y+=40)line(0,y,720,y,'#162b3b');
    arc(145,0,Math.PI*2,'#263c4b');arc(92,0,Math.PI*2,'#213945');
    window.QTEArt?.field(ctx,s,400);
    const nz=window.NazarickQTE?.identity(s.p);
    if(nz){text(s.p.skill.name+' · ФАЗА '+nz.phase,cx,25,window.NazarickQTE.colors[nz.who],15);}
    if(nz?.who==='ainz'&&nz.phase===2&&staffArt?.complete&&staffArt.naturalWidth){ctx.save();ctx.shadowColor='#b090f4';ctx.shadowBlur=12;ctx.drawImage(staffArt,626,66+Math.sin(t*2)*6,78,116);ctx.restore();text('ПАРЯЩИЙ ПОСОХ',640,204,'#ba9ae9',10);}
    if(C){
      ctx.save();ctx.globalAlpha=.48;arc(170,0,Math.PI*2,'#b99b65',2);
      for(let i=0;i<12;i++){const a=i*Math.PI/6-Math.PI/2;line(cx+Math.cos(a)*151,cy+Math.sin(a)*151,cx+Math.cos(a)*165,cy+Math.sin(a)*165,'#c8b582',i%3?1:3);}
      text('XII',cx,43,'#cab889',13);text('III',cx+186,205,'#cab889',13);text('VI',cx,387,'#cab889',13);text('IX',cx-186,205,'#cab889',13);
      ctx.restore();text(C.phase>=4?'SYSTEM / ПОЛНЫЙ ДОСТУП':C.phase===3?'SYSTEM / РУЧНОЕ ВМЕШАТЕЛЬСТВО':'РЕГЛАМЕНТ ПЕРЕХВАТА',cx,23,'#d6c493',12);
    }
    function chaplainThreat(e,v,c){
      const elapsed=t-(e.at-e.warning),pause=e.pauseFor||0,pauseAt=(e.warning-pause)*.45;
      const frozen=pause&&elapsed>=pauseAt&&elapsed<pauseAt+pause;
      const flight=E.clamp((elapsed-E.clamp(elapsed-pauseAt,0,pause))/(e.warning-pause),0,1);
      const a=e.angle,r=162-flight*113,tx=cx+Math.cos(a)*r,ty=cy+Math.sin(a)*r;
      if(e.kind==='wave'){
        const radius=162-v*113;
        arc(radius,0,Math.PI*2,c,4);arc(radius+8,0,Math.PI*2,c,1);
        for(let j=0;j<12;j++){const aa=j*Math.PI/6+(e.motif==='clock'?t*.4:0);line(cx+Math.cos(aa)*(radius+8),cy+Math.sin(aa)*(radius+8),cx+Math.cos(aa)*(radius+22),cy+Math.sin(aa)*(radius+22),c,2);}
        return;
      }
      // Direction is committed early. A gold notch always shows the real impact side.
      if(e.kind!=='feint'){ctx.save();ctx.lineWidth=5;arc(54,a-.10,a+.10,c,5);ctx.restore();}
      if(e.motif==='hand'){
        const turn=QTEBlock.angleDiff(a,e.originAngle),angle=e.originAngle+turn*E.clamp(flight/.45,0,1);
        ctx.save();ctx.globalAlpha*=.35;ctx.setLineDash([4,5]);line(cx+Math.cos(a)*160,cy+Math.sin(a)*160,cx+Math.cos(a)*54,cy+Math.sin(a)*54,c,2);ctx.restore();
        ctx.save();ctx.translate(cx,cy);ctx.rotate(angle);ctx.strokeStyle=c;ctx.lineWidth=4;ctx.beginPath();ctx.moveTo(18,0);ctx.lineTo(r-14,0);ctx.stroke();
        ctx.fillStyle=c;ctx.beginPath();ctx.moveTo(r,0);ctx.lineTo(r-20,-7);ctx.lineTo(r-14,0);ctx.lineTo(r-20,7);ctx.closePath();ctx.fill();ctx.restore();
        if(frozen){arc(179,a-.17,a+.17,'#b9d8ef',5);text('ПАУЗА',cx+Math.cos(a)*204,cy+Math.sin(a)*172,'#bdd8ed',12);}
      }else if(['window','denied','delete','admin'].includes(e.motif)){
        const x=cx+Math.cos(a)*118,y=cy+Math.sin(a)*118,w=112,h=43,feint=e.kind==='feint';
        ctx.fillStyle='#0c1522';ctx.fillRect(x-w/2,y-h/2,w,h);ctx.strokeStyle=feint?'#c99eaf':c;ctx.lineWidth=2;ctx.setLineDash(feint?[4,4]:[]);ctx.strokeRect(x-w/2,y-h/2,w,h);ctx.setLineDash([]);
        line(x-w/2,y-7,x+w/2,y-7,feint?'#c99eaf':c,1);
        text(feint?'ЛОЖНЫЙ':e.motif==='delete'?'DELETE':e.motif==='admin'?'ADMIN / WRITE':'ACCESS / WRITE',x,y-11,feint?'#dec3d0':c,10);
        text(feint?'НЕ ПОДТВЕРЖДАТЬ':e.motif==='delete'?'УДАЛИТЬ ЩИТ':'ПЕРЕХВАТИТЬ',x,y+11,feint?'#dec3d0':c,10);
        if(feint){line(x-9,y-2,x+9,y+15,'#d7a6b9',2);line(x+9,y-2,x-9,y+15,'#d7a6b9',2);}
        else{ctx.save();ctx.globalAlpha*=v;line(x,y,cx+Math.cos(a)*51,cy+Math.sin(a)*51,c,3);ctx.restore();}
      }else{
        ctx.save();ctx.setLineDash(e.motif==='echo'?[3,6]:[6,6]);line(cx+Math.cos(a)*160,cy+Math.sin(a)*160,cx+Math.cos(a)*52,cy+Math.sin(a)*52,e.motif==='echo'?'#b9acd8':c,2);ctx.restore();
        ctx.save();ctx.translate(tx,ty);ctx.rotate(a+Math.PI);ctx.fillStyle=c;
        if(e.motif==='bell'){ctx.beginPath();ctx.arc(0,0,10,Math.PI,0);ctx.lineTo(13,9);ctx.lineTo(-13,9);ctx.closePath();ctx.fill();}
        else if(e.motif==='cut'){ctx.fillRect(-20,-3,40,6);ctx.rotate(Math.PI/4);ctx.fillRect(-15,-2,30,4);}
        else if(e.motif==='stamp'){ctx.strokeStyle=c;ctx.lineWidth=3;ctx.strokeRect(-10,-10,20,20);ctx.fillRect(-5,-5,10,10);}
        else{ctx.beginPath();ctx.moveTo(12,0);ctx.lineTo(-9,-7);ctx.lineTo(-4,0);ctx.lineTo(-9,7);ctx.closePath();ctx.fill();}
        ctx.restore();
      }
    }
    if(t>=s.preparation)for(const e of s.events){
      if(s.enabledStrikes&&!s.enabledStrikes[e.strike]||t<e.at-e.warning||t>e.at+.26)continue;
      const v=nz?window.NazarickQTE.blockFlight(e,t):E.clamp((t-e.at+e.warning)/e.warning,0,1),c=e.tier==='critical'?'#fff0b6':e.tier==='minor'?'#92b4c6':'#e7bb77';
      ctx.save();ctx.globalAlpha=e.resolved?.15:.4+v*.6;
      if(nz){
        const a=e.angle,r=162-v*113,x=cx+Math.cos(a)*r,y=cy+Math.sin(a)*r,color=e.color||window.NazarickQTE.colors[nz.who];
        if(nz.who==='ainz'&&nz.phase===1&&e.stone!==undefined)text('КАМЕНЬ '+(e.stone+1)+' / 7',cx,57,color,17);
        if(e.kind==='wave'){arc(r,0,Math.PI*2,color,5);text('ИМПУЛЬС · ПОДНИМИ ЩИТ',cx,310,color,13);}
        else{
          ctx.setLineDash([4,5]);line(cx+Math.cos(a)*165,cy+Math.sin(a)*165,cx+Math.cos(a)*54,cy+Math.sin(a)*54,color,2);ctx.setLineDash([]);
          ctx.save();ctx.translate(x,y);ctx.rotate(a+Math.PI);ctx.strokeStyle=color;ctx.fillStyle=color;ctx.lineWidth=3;
          if(e.status==='burn'){
            ctx.shadowColor='#ff451b';ctx.shadowBlur=20;ctx.beginPath();ctx.moveTo(16,0);ctx.quadraticCurveTo(-2,-20,-26,0);ctx.quadraticCurveTo(-2,20,16,0);ctx.fill();ctx.fillStyle='#ffc15b';ctx.beginPath();ctx.arc(2,0,5,0,Math.PI*2);ctx.fill();
          }
          else if(nz.who==='demiurge'){ctx.shadowColor='#dc2549';ctx.shadowBlur=15;ctx.beginPath();for(let j=0;j<6;j++){const b=(j*2%5)*Math.PI*2/5;ctx.lineTo(Math.cos(b)*14,Math.sin(b)*14);}ctx.stroke();}
          else if(['false_light','lightning'].includes(e.motif)){
            ctx.shadowColor='#82b6ff';ctx.shadowBlur=16;ctx.strokeStyle='#b4d5ff';ctx.beginPath();ctx.moveTo(-34,0);for(let j=0;j<8;j++)ctx.lineTo(-30+j*8,Math.sin(j*2.7)*9);ctx.stroke();
          }
          else if(e.motif==='skull'){ctx.fillStyle='#eee6db';ctx.beginPath();ctx.ellipse(0,-2,11,13,0,0,Math.PI*2);ctx.fill();ctx.fillRect(-7,2,14,8);ctx.fillStyle='#120d19';ctx.fillRect(-7,-5,5,5);ctx.fillRect(2,-5,5,5);ctx.fillRect(-1,2,2,3);}
          else if(e.motif==='bone'){ctx.strokeStyle='#e4dfda';ctx.fillStyle='#e4dfda';line(-18,0,18,0,'#e4dfda',6);for(const end of[-1,1])for(const side of[-1,1]){ctx.beginPath();ctx.arc(end*18,side*4,5,0,Math.PI*2);ctx.fill();}}
          else if(nz.who==='pandora'){ctx.beginPath();ctx.ellipse(0,0,10,14,0,0,Math.PI*2);ctx.fill();ctx.fillStyle='#10101c';ctx.fillRect(-6,-5,4,4);ctx.fillRect(2,-5,4,4);ctx.fillRect(-2,3,4,6);}
          else if(nz.who==='albedo'){
            ctx.shadowColor='#9d5ee0';ctx.shadowBlur=14;ctx.fillStyle='#0c0712';
            if(e.motif==='wing'){ctx.beginPath();ctx.moveTo(16,0);ctx.bezierCurveTo(-6,-23,-36,-8,-32,0);ctx.bezierCurveTo(-34,12,-4,20,16,0);ctx.fill();ctx.stroke();line(-31,0,16,0,color,2);}
            else{line(-38,0,25,0,color,4);ctx.beginPath();ctx.moveTo(23,0);ctx.lineTo(-4,-23);ctx.lineTo(3,0);ctx.lineTo(-4,23);ctx.closePath();ctx.fill();ctx.stroke();}
          }
          else if(nz.who==='shalltear'&&e.motif==='bat'){
            ctx.shadowColor='#ff1749';ctx.shadowBlur=e.tier==='heavy'?22:12;ctx.beginPath();ctx.moveTo(10,0);ctx.lineTo(-4,-5);ctx.lineTo(-12,-19);ctx.lineTo(-20,-5);ctx.lineTo(-6,0);ctx.lineTo(-20,5);ctx.lineTo(-12,19);ctx.lineTo(-4,5);ctx.closePath();ctx.fill();
          }
          else if(nz.who==='shalltear'&&e.motif==='eye'){ctx.beginPath();ctx.ellipse(0,0,16,8,0,0,Math.PI*2);ctx.stroke();ctx.beginPath();ctx.arc(0,0,5,0,Math.PI*2);ctx.fill();}
          else if(nz.who==='ainz'){
            if(e.motif==='blackhole'){ctx.fillStyle='#03020a';ctx.shadowColor='#a566ee';ctx.shadowBlur=18;ctx.beginPath();ctx.arc(0,0,18,0,Math.PI*2);ctx.fill();ctx.stroke();for(let j=0;j<3;j++){ctx.rotate(.8);ctx.beginPath();ctx.ellipse(0,0,24+j*4,8,0,0,Math.PI*2);ctx.stroke();}}
            else{ctx.fillStyle=e.color||'#bdd7ff';ctx.shadowColor=ctx.fillStyle;ctx.shadowBlur=18;ctx.beginPath();ctx.arc(0,0,e.tier==='minor'?6:10,0,Math.PI*2);ctx.fill();ctx.stroke();}
          }
          else{ctx.beginPath();ctx.moveTo(18,0);ctx.lineTo(-12,-5);ctx.lineTo(-6,0);ctx.lineTo(-12,5);ctx.closePath();ctx.fill();}
          ctx.restore();
        }
      }else if(C)chaplainThreat(e,v,c);
      else if(window.QTEArt?.block(ctx,s,e,v)){/* Native class projectile, same timing/direction. */}
      else if(e.kind==='wave'){arc(155-v*107,0,Math.PI*2,c,4);text('ВОЛНА · ПОДНИМИ БЛОК',cx,309,'#f0cd92',13);}
      else{
        const r=162-v*113,x=cx+Math.cos(e.angle)*r,y=cy+Math.sin(e.angle)*r;
        ctx.setLineDash([5,6]);line(cx+Math.cos(e.angle)*160,cy+Math.sin(e.angle)*160,cx+Math.cos(e.angle)*52,cy+Math.sin(e.angle)*52,c);ctx.setLineDash([]);
        ctx.translate(x,y);ctx.rotate(e.angle+Math.PI);ctx.fillStyle=c;
        if(e.motif==='casino_card'){ctx.fillRect(-10,-7,20,14);ctx.fillStyle='#14251e';ctx.fillRect(-2,-2,4,4);}
        else if(e.motif==='casino_coin'){ctx.beginPath();ctx.arc(0,0,9,0,Math.PI*2);ctx.stroke();ctx.fillRect(-2,-4,4,8);}
        else if(e.motif==='casino_reel'){ctx.strokeRect(-12,-12,24,24);text('7',0,5,c,18);}
        else if(e.kind==='slash'){ctx.fillRect(-16,-4,32,8);ctx.fillRect(3,-10,3,20);}else{ctx.beginPath();ctx.moveTo(11,0);ctx.lineTo(-7,-6);ctx.lineTo(-7,6);ctx.closePath();ctx.fill();}
      }ctx.restore();
    }
    ctx.save();ctx.translate(cx,cy);ctx.rotate(Math.PI/4);ctx.fillStyle='#9cd9c9';ctx.shadowColor='#84ceb8';ctx.shadowBlur=14;ctx.fillRect(-9,-9,18,18);ctx.restore();
    if(nz&&window.NazarickQTE.timeStopped(s))text('ВРЕМЯ ОСТАНОВЛЕНО · ЩИТ НЕДОСТУПЕН',cx,65,'#c3d7ff',17);
    if(s.active){ctx.save();ctx.shadowColor=t<=s.perfectUntil?'#fff0ad':'#c7a873';ctx.shadowBlur=12;arc(48,s.angle-s.params.arc/2,s.angle+s.params.arc/2,t<=s.perfectUntil?'#fff1bd':'#e0be7b',9);ctx.restore();}
    else{ctx.setLineDash([4,6]);arc(48,s.angle-s.params.arc/2,s.angle+s.params.arc/2,t<s.brokenUntil?'#c77f79':'#627b86',3);ctx.setLineDash([]);}
    for(const c of s.contacts){const age=t-c.time;if(age<0||age>.8)continue;ctx.save();ctx.globalAlpha=1-age/.8;
      text(c.outcome==='feint'?(c.staminaCost?'ЛОЖНЫЙ ЗАПРОС · −'+Math.ceil(c.staminaCost)+' СТОЙКОСТИ':'ЗАПРОС ОТКЛОНЁН'):c.outcome==='perfect'?'ТОЧНЫЙ БЛОК':c.outcome==='block'?'БЛОК −'+c.damage:c.outcome==='break'?'ПРОБИТИЕ −'+c.damage:'−'+c.damage,cx,134-age*40,c.outcome==='perfect'?'#fff1bd':c.outcome==='block'||c.outcome==='feint'&&!c.staminaCost?'#a4d6b8':'#edaaa2',17);ctx.restore();}
    if(C&&t>=s.preparation){
      const next=s.events.find(e=>!e.resolved&&(!s.enabledStrikes||s.enabledStrikes[e.strike]));
      if(next&&t>=next.at-next.warning){
        const label=next.kind==='feint'?'ЛОЖНЫЙ ЗАПРОС · ОПУСТИ ЩИТ':next.kind==='wave'?'ВОЛНА · ПОДНИМИ ЩИТ ЗАНОВО':next.motif==='echo'?'ОТКАТ · ПРЕЖНЕЕ НАПРАВЛЕНИЕ':next.motif==='hand'?'СТРЕЛКА · ЛОВИ ЗОЛОТУЮ ОТМЕТКУ':'ПЕРЕХВАТИ ЗОЛОТОЙ СИГНАЛ';
        text(label,cx,330,next.kind==='feint'?'#dfb9cb':'#edcf97',12);text(Math.max(0,next.at-t).toFixed(1)+' с',cx,350,'#c6d7df',13);
      }
    }
    if(t<s.preparation){text('ПРИГОТОВЬСЯ',cx,65,'#e8bf78',24);text((s.preparation-t).toFixed(1)+' с',cx,110,'#e8eff2',27);}
    else text(s.active?'ЩИТ ПОДНЯТ':'ОПУСТИ ЩИТ — ВОССТАНОВИ СТОЙКОСТЬ',cx,368,'#9eb7bd',13);
  }
})();
